#!/bin/bash

export FREERDP_ONEMIX_OUTPUT="${FREERDP_ONEMIX_OUTPUT-eDP-1}"
if [ "${FREERDP_EXTERNAL_OUTPUT+x}" = x ]; then
    external_output_auto=0
else
    external_output_auto=1
fi
export FREERDP_EXTERNAL_OUTPUT

# Parse CLI arguments — accept only optional --mouse-only
mouse_only=0
for arg in "$@"; do
	case "$arg" in
		--mouse-only) mouse_only=1 ;;
		*)
			echo "ERROR: Unknown argument '$arg'" >&2
			echo "Usage: $0 [--mouse-only]" >&2
			exit 1
			;;
	esac
done

while true; do
    clear
    echo "======================"
    echo "   Debian Mode Menu"
    echo "======================"
    echo "1. GNOME ON"
    echo "2. GNOME OFF (Terminal only)"
    echo "3. Start RDP Window"
    echo "4. Battery"
    echo "5. Brightness"
    echo "6. Exit"
    echo "======================"

    read -p "Choose: " choice

    case $choice in
        1)
            echo "Starting GNOME..."
            sudo systemctl isolate graphical.target
            ;;
        2)
            echo "Stopping GNOME, switching to terminal..."
            sudo systemctl isolate multi-user.target
            ;;
        3)
    echo "Starting RDP..."

    IFS= read -r -s -p "RDP Password: " PASS
    echo

    # Construct the password argument
    printf -v pass_arg '/p:%s' "$PASS"

    # Private temporary xinitrc with cleanup
    umask 077
    xinitrc="$(mktemp /tmp/.xinitrc-rdp-XXXXXX)"
    trap 'rm -f "$xinitrc"' EXIT INT HUP TERM
    chmod 700 "$xinitrc"

    # Serialize the password argument with Bash-safe quoting
    pass_arg_q="$(printf '%q' "$pass_arg")"

    cat > "$xinitrc" <<'XEOF'
#!/usr/bin/env bash

set -eu
export XDG_SESSION_TYPE=x11
XEOF

    # Propagate diagnostic mode if enabled
    if [ "${FREERDP_TOUCH_DIAG:-}" = "1" ]; then
        printf 'export FREERDP_TOUCH_DIAG=1\n' >> "$xinitrc"
    fi
    printf 'external_output_auto=%s\n' "$external_output_auto" >> "$xinitrc"

    cat >> "$xinitrc" <<'XEOF'

onemix_output="${FREERDP_ONEMIX_OUTPUT:-}"
external_output="${FREERDP_EXTERNAL_OUTPUT:-}"

if ! xrandr_query="$(xrandr --query)"; then
    printf '%s\n' 'ERROR: unable to query outputs from the private X server' >&2
    exit 1
fi

show_outputs() {
    printf '%s\n' 'Connected-output listing from the private X server:' >&2
    printf '%s\n' "$xrandr_query" >&2
}

reject_output() {
    printf 'ERROR: %s\n' "$1" >&2
    show_outputs
    exit 1
}

[ -n "$onemix_output" ] || reject_output 'FREERDP_ONEMIX_OUTPUT is required'

output_is_connected() {
    wanted=$1
    while IFS=' ' read -r name status rest; do
        if [ "$name" = "$wanted" ] && [ "$status" = connected ]; then
            return 0
        fi
    done <<EOF
$xrandr_query
EOF
    return 1
}

output_is_connected "$onemix_output" || \
    reject_output "FREERDP_ONEMIX_OUTPUT '$onemix_output' is not connected"

if [ "$external_output_auto" -eq 1 ] && [ -z "$external_output" ]; then
    while IFS=' ' read -r candidate status rest; do
        if [ "$status" = connected ] && [ "$candidate" != "$onemix_output" ]; then
            external_output=$candidate
            break
        fi
    done <<EOF
$xrandr_query
EOF
fi

if [ -n "$external_output" ] && [ "$onemix_output" = "$external_output" ]; then
    reject_output 'FREERDP_ONEMIX_OUTPUT and FREERDP_EXTERNAL_OUTPUT must differ'
fi

if [ -n "$external_output" ] && ! output_is_connected "$external_output"; then
    reject_output "FREERDP_EXTERNAL_OUTPUT '$external_output' is not connected"
fi

if [ -n "$external_output" ]; then
    external_desktop_scale="${FREERDP_EXTERNAL_DESKTOP_SCALE-}"
    [ -n "$external_desktop_scale" ] || external_desktop_scale=100
    case "$external_desktop_scale" in
        [1-4][0-9][0-9]|500) ;;
        *) reject_output 'FREERDP_EXTERNAL_DESKTOP_SCALE must be a whole percent from 100 through 500' ;;
    esac
    export FREERDP_EXTERNAL_DESKTOP_SCALE="$external_desktop_scale"
else
    unset FREERDP_EXTERNAL_DESKTOP_SCALE
fi

xrandr --output "$onemix_output" --mode 1600x2560 --rotate left --primary
if [ -n "$external_output" ]; then
    xrandr --output "$external_output" --auto --above "$onemix_output"
    xrandr --listmonitors
fi

if [ -n "$external_output" ]; then
    xinput map-to-output "GXTP7386:00 27C6:0113" "$onemix_output"
else
    xinput set-prop "GXTP7386:00 27C6:0113" \
    "Coordinate Transformation Matrix" \
    0 -1 1 1 0 0 0 0 1
fi

multimon_arg=
if [ -n "$external_output" ]; then
    multimon_arg=/multimon
fi

XEOF

    printf 'exec /home/hoang/freerdp-touch/scripts/launch-touch.sh' >> "$xinitrc"
    if [ "$mouse_only" -eq 1 ]; then
        printf ' --mouse-only' >> "$xinitrc"
    fi
    printf ' ${multimon_arg:+$multimon_arg}' >> "$xinitrc"
    printf ' /v:192.168.1.10 /u:ngleh %s /f /smart-sizing:2560x1600 /scale-desktop:200 /clipboard /sound:sys:pulse /microphone:sys:pulse /drive:Onemix,$HOME /cert:ignore\n' "$pass_arg_q" >> "$xinitrc"

    startx "$xinitrc"
    startx_rc=$?
    rm -f "$xinitrc"
    if [ "$startx_rc" -ne 0 ]; then
        exit "$startx_rc"
    fi

    read
    ;;
	4)
	    upower -i /org/freedesktop/UPower/devices/battery_BAT0
	    read -r -p "Press Enter key to back menu..."
	    ;;
	5)
	    read -r -p "Input brightess:" BRIGHT
	    echo $BRIGHT | sudo tee /sys/class/backlight/intel_backlight/brightness
	    ;;

        6)
            exit 0
            ;;
        *)
            echo "Invalid option"
            read
            ;;
    esac
done
