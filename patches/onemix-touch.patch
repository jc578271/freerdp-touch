+	input.context = &xfc.common.context;
+	input.MouseEvent = capture_mouse_event;
+	xfc.common.context.input = &input;
+	mouse_events = (mouse_capture){ 0 };
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 71, 20, 30) == 0, "one-finger Begin");
+	CHECK(xfc.lpDeadline - xfc.lpStartTime == 500, "zero duration fallback arms for 500ms");
+	CHECK(dispatch_touch(&xfc, XI_TouchUpdate, 71, 30, 30) == 0,
+	      "one-finger 10px Update");
+	CHECK(xfc.lpArmed && !xfc.fallbackActive && mouse_events.count == 0,
+	      "10px one-finger motion remains below 12px slop");
+	CHECK(dispatch_touch(&xfc, XI_TouchUpdate, 71, 33, 30) == 0,
+	      "one-finger 13px Update");
+	CHECK(xfc.fallbackActive && mouse_events.count == 2 &&
+	          mouse_events.flags[0] == (PTR_FLAGS_DOWN | PTR_FLAGS_BUTTON1) &&
+	          mouse_events.flags[1] == PTR_FLAGS_MOVE,
+	      "13px one-finger motion claims a left-button drag");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 71, 33, 30) == 0, "one-finger End");
+	CHECK(mouse_events.count == 3 && mouse_events.flags[2] == PTR_FLAGS_BUTTON1,
+	      "one-finger drag releases its left button");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
