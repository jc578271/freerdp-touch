+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state pending->pinch contacts=%d", xfc->active_contacts);
+				WLog_DBG(TAG,
+				    "pinch: claimed d=%.1f A=%d B=%d", pinchDelta,
+				    xfc->pinchFingerA, xfc->pinchFingerB);
+				xf_input_pinch_update(xfc, touchId, x, y);
+				return 0;
+			}
+			if (claim == 2) /* SCROLL */
+			{
+				xfc->twoFingerPending = FALSE;
+				xfc->scrollActive = TRUE;
+				xfc->scrollLastY = currentMidY;
+				xfc->scrollAccum = 0;
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state pending->scroll contacts=%d", xfc->active_contacts);
+				/* Move the hidden remote pointer to the two-finger midpoint
+				 * before the first wheel detent. */
+				freerdp_client_send_button_event(&xfc->common, FALSE,
+				                                 PTR_FLAGS_MOVE, currentMidX,
+				                                 currentMidY);
+				WLog_DBG(TAG,
+				    "pan: claimed two-finger scroll d=%.1f mid=(%d,%d)",
+				    panDelta, currentMidX, currentMidY);
