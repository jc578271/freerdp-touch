+/* Convert XI2 scroll valuators into existing RDP wheel detents.
+ * xf86-input-libinput: Rel X=0, Rel Y=1, Rel Horiz Scroll=2, Rel Vert Scroll=3.
+ * Called from XI_Motion and XI_RawMotion. XI 2.1+ clients do not get Button4/5.
+ * Walks set valuators the same way xf_input_pen_remote walks event->valuators.
+ * Uses the same 0x78 detent magnitude as Button4/5 and two-finger scroll. */
+void xf_input_send_wheel_from_valuators(xfContext* xfc, const unsigned char* mask,
+                                        int mask_len, const double* values,
+                                        BOOL relative)
+{
+	if (!xfc || !mask || mask_len <= 0 || !values)
+		return;
+
+	const double* val = values;
+	for (int i = 0; i < mask_len * 8; i++)
+	{
+		if (XIMaskIsSet(mask, i))
+		{
+			double v = *val++;
+			double delta;
+			if (i < 2)
+				continue; /* ignore x/y axes */
+
+			if (relative)
+			{
+				delta = v;
+			}
+			else
+			{
+				double* last = (i == 2) ? &xfc->wheelLastHoriz : &xfc->wheelLastVert;
+				delta = v - *last;
+				*last = v;
+			}
+			if (delta == 0.0)
+				continue;
+
+			UINT16 flags = (i == 2) ? PTR_FLAGS_HWHEEL : PTR_FLAGS_WHEEL;
+			if ((i == 2) ? (delta < 0.0) : (delta > 0.0))
+				flags |= PTR_FLAGS_WHEEL_NEGATIVE | (0x100 - 0x78);
+			else
+				flags |= 0x78;
+
+			freerdp_client_send_wheel_event(&xfc->common, flags);
+		}
+	}
