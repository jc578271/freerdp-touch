+static rdpSettings* new_settings(void)
+{
+	rdpSettings* settings = freerdp_settings_new(0);
+
+	if (!settings)
+		return NULL;
+	if (!freerdp_settings_set_bool(settings, FreeRDP_TouchPinchWheelFallback, TRUE) ||
+	    !freerdp_settings_set_bool(settings, FreeRDP_MultiTouchInput, FALSE) ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopWidth, 100) ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopHeight, 100))
+	{
+		freerdp_settings_free(settings);
+		return NULL;
+	}
+	return settings;
+}
+
+static void init_context(xfContext* xfc, rdpSettings* settings)
+{
+	memset(xfc, 0, sizeof(*xfc));
+	xfc->common.context.settings = settings;
+	xfc->XInputOpcode = 77;
+	xfc->cursorHidden = TRUE;
+	xfc->remote_app = FALSE;
+	xfc->offset_x = 10;
+	xfc->offset_y = 20;
+	xfc->scaledWidth = 100;
+	xfc->scaledHeight = 100;
+}
+
+static void make_touch_event(XEvent* event, XIDeviceEvent* device, const xfContext* xfc,
+                             int evtype, int touch_id, int x, int y)
+{
+	memset(event, 0, sizeof(*event));
+	memset(device, 0, sizeof(*device));
+
+	event->xcookie.type = GenericEvent;
+	event->xcookie.extension = xfc->XInputOpcode;
+	event->xcookie.evtype = evtype;
+	event->xcookie.data = device;
+
+	device->type = GenericEvent;
+	device->extension = xfc->XInputOpcode;
+	device->evtype = evtype;
+	device->detail = touch_id;
+	device->event_x = x;
+	device->event_y = y;
+}
+
+static int dispatch_touch(xfContext* xfc, int evtype, int touch_id, int x, int y)
+{
+	XEvent event;
+	XIDeviceEvent device;
+
+	make_touch_event(&event, &device, xfc, evtype, touch_id, x, y);
+	return xf_input_handle_event(xfc, &event);
+}
