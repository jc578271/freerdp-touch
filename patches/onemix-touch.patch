+/* Valuator wheel tests: xf86-input-libinput delivers Rel Horiz Scroll on axis 2
+ * and Rel Vert Scroll on axis 3 (not discrete Button4/5 for XI 2.1+ clients).
+ * The helper converts those to the same 0x78 detent encoding as Button4/5. */
+
+static int test_valuator_wheel_vertical_positive(void)
+{
+	rdpSettings* settings = new_settings();
+	rdpInput input = { 0 };
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	input.context = &xfc.common.context;
+	input.MouseEvent = capture_mouse_event;
+	xfc.common.context.input = &input;
+	mouse_events = (mouse_capture){ 0 };
+
+	unsigned char mask[1] = { 0x08 }; /* bit 3 Rel Vert Scroll */
+	double seed[1] = { 0.0 };
+	double values[1] = { 1.0 };
+
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, seed, FALSE);
+	CHECK(mouse_events.count == 0, "first vertical sample only seeds last value");
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, values, FALSE);
+
+	CHECK(mouse_events.count == 1, "one wheel event emitted");
+	CHECK(mouse_events.flags[0] == (PTR_FLAGS_WHEEL | PTR_FLAGS_WHEEL_NEGATIVE | (0x100 - 0x78)),
+	      "positive vertical delta matches Button5 wheel-down detent");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
