+static int test_double_tap_anchor(void)
+{
+	rdpSettings* settings = new_settings();
+	rdpInput input = { 0 };
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	input.context = &xfc.common.context;
+	input.MouseEvent = capture_mouse_event;
+	xfc.common.context.input = &input;
+	mouse_events = (mouse_capture){ 0 };
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 61, 20, 30) == 0, "first Begin");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 61, 20, 30) == 0, "first End");
+	CHECK(mouse_events.count == 2, "first short tap is immediate");
+	CHECK(mouse_events.flags[0] == (PTR_FLAGS_DOWN | PTR_FLAGS_BUTTON1) &&
+	          mouse_events.flags[1] == PTR_FLAGS_BUTTON1,
+	      "first tap emits one left-click pair");
+	CHECK(mouse_events.x[0] == 10 && mouse_events.y[0] == 10 && mouse_events.x[1] == 10 &&
+	          mouse_events.y[1] == 10,
+	      "first tap uses adjusted coordinates");
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 62, 30, 30) == 0, "second Begin");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 62, 30, 30) == 0, "second End");
+	CHECK(mouse_events.count == 4, "two taps emit two complete click pairs");
+	for (size_t i = 0; i < mouse_events.count; i++)
+	{
+		CHECK(mouse_events.flags[i] ==
+		          ((i % 2 == 0) ? (PTR_FLAGS_DOWN | PTR_FLAGS_BUTTON1) : PTR_FLAGS_BUTTON1),
+		      "tap pair flags are ordered down/up");
+		CHECK(mouse_events.x[i] == 10 && mouse_events.y[i] == 10,
+		      "10px nearby second tap reuses the first adjusted coordinate");
+	}
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 63, 20, 30) == 0, "capture-vector first Begin");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 63, 20, 30) == 0, "capture-vector first End");
+	CHECK(mouse_events.count == 6, "capture-vector first tap creates a fresh anchor");
+	/* The capture includes a 14-by-9 px (16.64 px) rapid retap.  It must
+	 * preserve the first remote coordinate without loosening drag/pan slop. */
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 64, 34, 39) == 0, "capture-vector second Begin");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 64, 34, 39) == 0, "capture-vector second End");
+	CHECK(mouse_events.count == 8, "capture-vector emits a complete second click");
+	CHECK(mouse_events.x[6] == 10 && mouse_events.y[6] == 10 && mouse_events.x[7] == 10 &&
+	          mouse_events.y[7] == 10,
+	      "16.64px rapid retap reuses the first adjusted coordinate");
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 65, 20, 30) == 0, "distant-pair first Begin");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 65, 20, 30) == 0, "distant-pair first End");
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 66, 70, 30) == 0, "distant-pair second Begin");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 66, 70, 30) == 0, "distant-pair second End");
+	CHECK(mouse_events.count == 12, "distant pair still emits two complete clicks");
+	CHECK(mouse_events.x[10] == 60 && mouse_events.y[10] == 10 && mouse_events.x[11] == 60 &&
+	          mouse_events.y[11] == 10,
+	      "50px rapid retap remains at its own adjusted coordinate");
+
+	xfc.tapPairTime -= 550;
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 67, 60, 30) == 0, "old-anchor Begin");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 67, 60, 30) == 0, "old-anchor End");
+	CHECK(mouse_events.count == 14, "old anchor still emits a complete click");
+	CHECK(mouse_events.x[12] == 50 && mouse_events.y[12] == 10 && mouse_events.x[13] == 50 &&
+	          mouse_events.y[13] == 10,
+	      "550ms-old tap anchor is too old to reuse");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
