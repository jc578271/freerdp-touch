+static int test_quarantine_recovery(void)
+{
+	rdpSettings* settings = new_settings();
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 11, 20, 30) == 0, "Begin(A)");
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 12, 40, 50) == 0, "Begin(B)");
+	CHECK(xfc.twoFingerPending, "two-finger pending after Begin(B)");
+
+	xf_touch_force_cancel(&xfc);
+	CHECK(xfc.quarantinedCount == 2 && xfc.recoveryGateArmed, "cancel quarantines A and B");
+	CHECK(has_quarantine(&xfc, 11) && has_quarantine(&xfc, 12), "cancel keeps both old IDs");
+
+	CHECK(dispatch_touch(&xfc, XI_TouchUpdate, 11, 25, 35) == 0, "old Update(A) consumed");
+	CHECK(xfc.quarantinedCount == 2, "old Update(A) preserves quarantine");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 11, 25, 35) == 0, "old End(A) consumed");
+	CHECK(xfc.quarantinedCount == 1 && xfc.recoveryGateArmed && has_quarantine(&xfc, 12),
+	      "partial End(A) keeps B and recovery gate armed");
+
+	xf_touch_force_cancel(&xfc);
+	CHECK(xfc.quarantinedCount == 1 && xfc.recoveryGateArmed && has_quarantine(&xfc, 12),
+	      "repeated cancellation preserves B");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 12, 40, 50) == 0, "old End(B) consumed");
+	CHECK(xfc.quarantinedCount == 0 && !xfc.recoveryGateArmed, "final old End(B) reopens input");
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 13, 60, 70) == 0, "fresh Begin(C)");
+	CHECK(xfc.lpArmed && xfc.lpFinger == 13, "fresh touch reaches local recognizer");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
