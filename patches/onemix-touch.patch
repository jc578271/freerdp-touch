+static BOOL xf_input_fire_long_press(xfContext* xfc)
+{
+	const int finger = xfc->lpFinger;
+	const int x = xfc->lpDownX;
+	const int y = xfc->lpDownY;
+
+	if (!xfc->lpArmed)
+		return FALSE;
