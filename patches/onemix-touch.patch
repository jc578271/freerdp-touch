+#include <stdio.h>
+
+#define PINCH_DEADBAND_PX 8
+#define PINCH_DOMINANCE_RATIO 2.5
+
+typedef enum { PENDING = 0, PINCH = 1, SCROLL = 2 } Claim;
+
+/* Resolve the disambiguation rule.  midpoints are computed with integer
+ * division to match the real code (currentMidX/Y are ints in the source). */
+static Claim resolve(double pinchFirstDist, double twoStartMidX,
+                     double twoStartMidY, double ax, double ay,
+                     double bx, double by, double panDb)
+{
+	double dx = ax - bx;
+	double dy = ay - by;
+	double currentDist = sqrt(dx * dx + dy * dy);
+	int currentMidX = (int)((ax + bx) / 2.0);
+	int currentMidY = (int)((ay + by) / 2.0);
+	int startMidX = (int)twoStartMidX;
+	int startMidY = (int)twoStartMidY;
+	double pinchDelta = fabs(currentDist - pinchFirstDist);
+	double panDelta = hypot((double)(currentMidX - startMidX),
+	                        (double)(currentMidY - startMidY));
+
+	/* Claim PINCH: distance change exceeds deadband AND dominates pan. */
+	if (pinchDelta >= (double)PINCH_DEADBAND_PX &&
+	    pinchDelta > (double)PINCH_DOMINANCE_RATIO * panDelta)
+		return PINCH;
+
+	/* Claim SCROLL: midpoint displacement exceeds pan deadband. */
+	if (panDelta >= (double)panDb)
+		return SCROLL;
+
+	return PENDING;
+}
+
+int main(void)
+{
+	/* --- Case 1: 9px one-finger-first vertical swipe (the bug-gate case)
+	 * A=(100,100), B=(100,300).  Baseline dist=200, mid=(100,200).
+	 * A moves alone to y=109: pinchDelta = |sqrt(0^2+191^2)-200| = 9.
+	 * integer midY = (109+300)/2 = 204, panDelta = hypot(0,4) = 4.
+	 * With 2.0 ratio: 9 > 2.0*4=8 → PINCH (bug).
+	 * With 2.5 ratio: 9 > 2.5*4=10 → FALSE → PENDING (fix). */
+	{
+		Claim c = resolve(200.0, 100.0, 200.0,
+		                  100.0, 109.0, 100.0, 300.0, 8.0);
+		assert(c == PENDING);
+		assert(c != PINCH);
+	}
+
+	/* --- Case 2: Vertical 9px first update, second finger catches up.
+	 * A stays at (100,109), B moves to (100,309).
+	 * pinchDelta = |sqrt(0^2+200^2)-200| = 0, panDelta=9 → SCROLL. */
+	{
+		Claim c = resolve(200.0, 100.0, 200.0,
+		                  100.0, 109.0, 100.0, 309.0, 8.0);
+		assert(c == SCROLL);
+	}
+
+	/* --- Case 3: Horizontal 8px one-finger-first swipe → PENDING.
+	 * A=(100,200), B=(300,200).  A→(108,200): pinchDelta=8, int midX=204, panDelta=4.
+	 * 8 > 2.5*4=10 → FALSE → PENDING. */
+	{
+		Claim c = resolve(200.0, 200.0, 200.0,
+		                  108.0, 200.0, 300.0, 200.0, 8.0);
+		assert(c == PENDING);
+		assert(c != PINCH);
+
+		/* Both catch up: A→(109,200), B→(309,200) → SCROLL. */
+		c = resolve(200.0, 200.0, 200.0,
+		            109.0, 200.0, 309.0, 200.0, 8.0);
+		assert(c == SCROLL);
+	}
+
+	/* --- Case 4: Sequential 8px-per-finger symmetric pinch IN.
+	 * A=(100,100), B=(100,300).  First: only A moves →(100,108).
+	 * pinchDelta=|sqrt(0^2+192^2)-200|=8, int midY=204, panDelta=4.
+	 * 8 > 2.5*4=10 → FALSE → PENDING. */
+	{
+		Claim c = resolve(200.0, 100.0, 200.0,
+		                  100.0, 108.0, 100.0, 300.0, 8.0);
+		assert(c == PENDING);
+
+		/* Second: B also moves →(100,292). Total A=108, B=292.
+		 * dist=|sqrt(0^2+184^2)-200|=16, midY=200, panDelta=0.
+		 * 16 > 2.5*0=0, 16 ≥ 8 → PINCH. */
+		c = resolve(200.0, 100.0, 200.0,
+		            100.0, 108.0, 100.0, 292.0, 8.0);
+		assert(c == PINCH);
+	}
+
+	/* --- Case 5: Single-update symmetric pinch IN (both move together).
+	 * A→(100,120), B→(100,280): pinchDelta=40, mid stays, panDelta=0 → PINCH. */
+	{
+		Claim c = resolve(200.0, 100.0, 200.0,
+		                  100.0, 120.0, 100.0, 280.0, 8.0);
+		assert(c == PINCH);
+	}
+
+	/* --- Case 6: Symmetric pinch OUT.
+	 * A→(100,80), B→(100,320): pinchDelta=40, panDelta=0 → PINCH. */
+	{
+		Claim c = resolve(200.0, 100.0, 200.0,
+		                  100.0, 80.0, 100.0, 320.0, 8.0);
+		assert(c == PINCH);
+	}
+
+	/* --- Case 7: Diagonal scroll — both fingers translate together. */
+	{
+		Claim c = resolve(200.0, 100.0, 200.0,
+		                  108.0, 108.0, 108.0, 308.0, 8.0);
+		assert(c == SCROLL);
+	}
+
+	printf("OK\n");
+	return 0;
+}
