 #define MIN_FINGER_DIST 5
 
+/* D-08: two-finger distance change required before first wheel detent (px) */
+#define PINCH_DEADBAND_PX 8
+
+/* ponytail: OneMix 3's rapid retaps reach 16.64 px; expose a separate setting
+ * only if another panel needs a different double-tap anchor tolerance. */
+#define DOUBLE_TAP_ANCHOR_SLOP_PX 48
+
+/* ponytail: structural geometric ratio, not a physical calibration value;
+ * promote to an rdpSetting only if real hardware jitter requires tuning
+ * (FreeRDP_TouchLongPressSlopPx pan deadband remains the user-facing knob).
+ *
+ * Disambiguation ratio: pinch distance-change must exceed midpoint movement
+ * by this factor before pinch wins over scroll.  The ideal one-finger-first
+ * geometric ratio is 2.0 (pinchDelta≈D, panDelta≈D/2), but the midpoint is
+ * computed with integer division which truncates D/2, so at the 8px claim
+ * threshold a 9px update gives pinchDelta=9, panDelta=4 → 9 > 2.0·4=8 →
+ * pinch still wins.  2.5 adds a 0.5 safety margin over the ideal 2.0 to
+ * cover integer midpoint quantization at every pixel boundary within the
+ * pinching range.  A true pinch with stationary midpoint (panDelta≈0) still
+ * claims within the existing deadband. */
+#define PINCH_DOMINANCE_RATIO 2.5
+
+/* D-09: inter-finger distance change per wheel detent (px) */
+#define PINCH_WHEEL_STEP_PX 40
+
+/* Two-finger midpoint translation per wheel detent (px) */
+#define SCROLL_WHEEL_STEP_PX 40
