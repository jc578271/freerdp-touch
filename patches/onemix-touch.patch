+static int has_quarantine(const xfContext* xfc, int touch_id)
+{
+	for (int i = 0; i < xfc->quarantinedCount; i++)
+	{
+		if (xfc->quarantinedFingers[i] == touch_id)
+			return 1;
+	}
+	return 0;
+}
