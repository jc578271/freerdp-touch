+static int xf_pointer_core_device_id(xfContext* xfc)
+{
+	int ndevices = 0;
+	XIDeviceInfo* info = NULL;
+
+	if (xfc->pointerCoreDeviceId != 0)
+		return xfc->pointerCoreDeviceId;
+
+	info = XIQueryDevice(xfc->display, XIAllDevices, &ndevices);
+	if (!info)
+	{
+		xfc->pointerCoreDeviceId = -1;
+		return -1;
+	}
+
+	xfc->pointerCoreDeviceId = -1;
+	for (int i = 0; i < ndevices; i++)
+	{
+		if (info[i].name && strcmp(info[i].name, "Virtual core pointer") == 0)
+		{
+			xfc->pointerCoreDeviceId = info[i].deviceid;
+			break;
+		}
+	}
+	XIFreeDeviceInfo(info);
+	return xfc->pointerCoreDeviceId;
+}
