+
+#include "../xf_event.h"
+
+#define CHECK(condition, message) \
+	do \
+	{ \
+		if (!(condition)) \
+		{ \
+			(void)fprintf(stderr, "FAIL: %s\n", message); \
+			return 1; \
+		} \
+	} while (0)
+
+static void init_above_fixture(rdpMonitor monitors[2], RECTANGLE_16 crtcs[2])
+{
+	memset(monitors, 0, sizeof(rdpMonitor) * 2);
+	memset(crtcs, 0, sizeof(RECTANGLE_16) * 2);
+
+	/* External CRTC 1920x1080 at (0,0) — secondary remote monitor. */
+	monitors[0].x = 0;
+	monitors[0].y = 0;
+	monitors[0].width = 1920;
+	monitors[0].height = 1080;
+	monitors[0].is_primary = FALSE;
+	monitors[0].orig_screen = 0;
+	monitors[0].attributes.desktopScaleFactor = 100;
+	crtcs[0].left = 0;
+	crtcs[0].top = 0;
+	crtcs[0].right = 1919;
+	crtcs[0].bottom = 1079;
+
+	/* OneMix primary CRTC 2560x1600 at (0,1080). */
+	monitors[1].x = 0;
+	monitors[1].y = 1080;
+	monitors[1].width = 2560;
+	monitors[1].height = 1600;
+	monitors[1].is_primary = TRUE;
+	monitors[1].orig_screen = 1;
+	monitors[1].attributes.desktopScaleFactor = 200;
+	crtcs[1].left = 0;
+	crtcs[1].top = 1080;
+	crtcs[1].right = 2559;
+	crtcs[1].bottom = 2679;
+}
+
+static int point_on_monitor(int x, int y, const rdpMonitor* mon)
+{
+	return x >= mon->x && x < mon->x + mon->width && y >= mon->y && y < mon->y + mon->height;
+}
+
+static int test_above_fixture(void)
+{
+	rdpMonitor monitors[2];
+	RECTANGLE_16 crtcs[2];
+	int x = 0;
+	int y = 0;
+	const int global_y = (int)(1080.0 * 1600.0 / 2680.0);
+
+	init_above_fixture(monitors, crtcs);
+
+	/* Today's global y factor 1600/2680 maps OneMix y=1080 to 644 (still external). */
+	CHECK(global_y == 644, "document current global squash mapping OneMix y=1080 to 644");
+
+	x = 100;
+	y = 1080;
+	CHECK(xf_pointer_map_coordinates(&x, &y, monitors, 2, crtcs), "map OneMix CRTC point");
+	CHECK(point_on_monitor(x, y, &monitors[1]), "OneMix CRTC point stays on primary rdpMonitor");
+	CHECK(!point_on_monitor(x, y, &monitors[0]), "OneMix CRTC point is not on secondary rdpMonitor");
+
+	x = 100;
+	y = 100;
+	CHECK(xf_pointer_map_coordinates(&x, &y, monitors, 2, crtcs), "map external CRTC point");
+	CHECK(point_on_monitor(x, y, &monitors[0]), "external CRTC point stays on secondary rdpMonitor");
+	CHECK(!point_on_monitor(x, y, &monitors[1]), "external CRTC point is not on primary rdpMonitor");
+
+	return 0;
+}
+
+static int test_shared_edge(void)
+{
+	rdpMonitor monitors[2];
+	RECTANGLE_16 crtcs[2];
+	int x = 0;
+	int y = 0;
+
+	init_above_fixture(monitors, crtcs);
+
+	x = 200;
+	y = 1080;
+	CHECK(xf_pointer_map_coordinates(&x, &y, monitors, 2, crtcs), "map OneMix side of shared edge");
+	CHECK(point_on_monitor(x, y, &monitors[1]), "OneMix side of shared edge maps to primary");
+
+	x = 200;
+	y = 1079;
+	CHECK(xf_pointer_map_coordinates(&x, &y, monitors, 2, crtcs), "map external side of shared edge");
+	CHECK(point_on_monitor(x, y, &monitors[0]), "external side of shared edge maps to secondary");
+
+	return 0;
+}
+
+static int test_scale_accel(void)
