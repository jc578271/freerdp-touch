+	for (UINT32 i = 0; i < nmonitors; i++)
+	{
+		const UINT32 orig = monitors[i].orig_screen;
+		const RECTANGLE_16* area = NULL;
+		if (orig >= xfc->vscreen.nmonitors)
+			return;
+		area = &xfc->vscreen.monitors[orig].area;
+		if (x >= (int)area->left && x <= (int)area->right && y >= (int)area->top &&
+		    y <= (int)area->bottom)
