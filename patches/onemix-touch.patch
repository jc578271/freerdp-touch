+typedef struct
+{
+	UINT16 flags[MAX_MOUSE_EVENTS];
+	UINT16 x[MAX_MOUSE_EVENTS];
+	UINT16 y[MAX_MOUSE_EVENTS];
+	size_t count;
+} mouse_capture;
+
+static char log_capture[16384];
+static mouse_capture mouse_events;
+
+static BOOL capture_mouse_event(rdpInput* input, UINT16 flags, UINT16 x, UINT16 y)
+{
+	(void)input;
+	if (mouse_events.count < MAX_MOUSE_EVENTS)
+	{
+		const size_t index = mouse_events.count++;
+		mouse_events.flags[index] = flags;
+		mouse_events.x[index] = x;
+		mouse_events.y[index] = y;
+	}
+	return TRUE;
+}
+
+Bool __wrap_XGetEventData(Display* display, XGenericEventCookie* cookie)
+{
+	(void)display;
+	(void)cookie;
+	return True;
+}
+
+void __wrap_XFreeEventData(Display* display, XGenericEventCookie* cookie)
+{
+	(void)display;
+	(void)cookie;
+}
+
+static BOOL capture_message(const wLogMessage* message)
+{
+	size_t used;
+
+	if (!message || !message->TextString || !strstr(message->TextString, "touch-diag:"))
+		return TRUE;
+
+	used = strlen(log_capture);
+	if (used < sizeof(log_capture) - 1)
+		(void)snprintf(log_capture + used, sizeof(log_capture) - used, "%s\n",
+		               message->TextString);
+	return TRUE;
+}
+
+static BOOL ignore_message(const wLogMessage* message)
+{
+	(void)message;
+	return TRUE;
+}
+
+static void clear_log_capture(void)
+{
+	log_capture[0] = '\0';
+}
+
+static int count_substring(const char* haystack, const char* needle)
+{
+	int count = 0;
+	const char* cursor = haystack;
+	size_t length = strlen(needle);
+
+	while ((cursor = strstr(cursor, needle)) != NULL)
+	{
+		count++;
+		cursor += length;
+	}
+	return count;
+}
+
+static int configure_log_capture(void)
+{
+	wLog* root = WLog_GetRoot();
+	wLog* x11 = WLog_Get("com.freerdp.client.x11");
+	wLogAppender* appender = NULL;
+	wLogCallbacks callbacks = { 0 };
+
+	if (!root || !x11)
+		return 0;
+
+	callbacks.data = ignore_message;
+	callbacks.image = ignore_message;
+	callbacks.message = capture_message;
+	callbacks.package = ignore_message;
+
+	if (!WLog_SetLogAppenderType(root, WLOG_APPENDER_CALLBACK))
+		return 0;
+	appender = WLog_GetLogAppender(root);
+	if (!appender || !WLog_ConfigureAppender(appender, "callbacks", &callbacks))
+		return 0;
+	if (!WLog_SetLogLevel(root, WLOG_TRACE) || !WLog_SetLogLevel(x11, WLOG_TRACE))
+		return 0;
+	return WLog_OpenAppender(root) ? 1 : 0;
+}
