Index: src/client/X11/xf_touch_internal.h
===================================================================
--- /dev/null
+++ src/client/X11/xf_touch_internal.h
@@ -0,0 +1,264 @@
+/*
+ * xf_touch_internal.h — Shared pure helpers for the X11 touch gesture layer.
+ *
+ * Both production xf_input.c and independent regression tests include this
+ * header.  No X11 or FreeRDP dependencies — only <math.h> and <stddef.h>.
+ */
+
+#ifndef XF_TOUCH_INTERNAL_H
+#define XF_TOUCH_INTERNAL_H
+
+#include <math.h>
+#include <stddef.h>
+
+/* ── GAP-03: bounds admission ────────────────────────────────────── */
+
+/* Returns 1 if the event should be admitted, 0 if it should be dropped.
+ * Only XI_TouchBegin outside the content rect is rejected.
+ * XI_TouchUpdate and XI_TouchEnd always reach cleanup (GAP-03, BL-03). */
+static inline int xf_bounds_admit(int is_begin, int x, int y, int left,
+                                  int top, int right, int bottom)
+{
+	if (!is_begin)
+		return 1;
+	if (x < left || x >= right || y < top || y >= bottom)
+		return 0;
+	return 1;
+}
+
+/* ── GAP-02/10: single runtime quarantine + gate owner ────────────── */
+
+/* Add a set of finger IDs to the quarantine array (dedup, bounds-check
+ * per maxContacts).  Consume End removals (one matched ID per endId).
+ * Every operation derives recoveryGateArmed from the final count.
+ * xf_quarantine_update is the only runtime writer of
+ * quarantinedFingers / quarantinedCount / recoveryGateArmed after
+ * xf_input_init. */
+static inline int xf_quarantine_update(int *fingers, int *count, int *gate,
+                                       const int *addIds, int addCount,
+                                       const int *endIds, int endCount,
+                                       int maxContacts)
+{
+	int i, j, ai, ei;
+
+	/* Consume End removals first — match one ID per endId. */
+	for (ei = 0; ei < endCount; ei++)
+	{
+		int eid = endIds[ei];
+		if (eid == 0)
+			continue;
+		for (i = 0; i < *count; i++)
+		{
+			if (fingers[i] == eid)
+			{
+				for (j = i; j < *count - 1; j++)
+					fingers[j] = fingers[j + 1];
+				(*count)--;
+				break;
+			}
+		}
+	}
+
+	/* Add set with dedup + bounds-check. */
+	for (ai = 0; ai < addCount; ai++)
+	{
+		int id = addIds[ai];
+		int dup;
+
+		if (id == 0)
+			continue;
+		dup = 0;
+		for (i = 0; i < *count; i++)
+		{
+			if (fingers[i] == id)
+			{
+				dup = 1;
+				break;
+			}
+		}
+		if (!dup && *count < maxContacts)
+			fingers[(*count)++] = id;
+	}
+
+	*gate = (*count > 0);
+	return *count;
+}
+
+/* Convenience: single-ID quarantine add (GAP-02). */
+static inline int xf_quarantine_add(int *fingers, int count, int fingerId, int maxContacts)
+{
+	int gate;
+	return xf_quarantine_update(fingers, &count, &gate, &fingerId, 1, NULL, 0, maxContacts);
+}
+
+/* Convenience: gate derive from count (GAP-02). */
+static inline int xf_gate_derive(int count)
+{
+	return count > 0;
+}
+
+/* ── WR-01: two-finger disambiguation classifier ─────────────────── */
+
+/* Returns 0=PENDING, 1=PINCH, 2=SCROLL.  Production and tests call the
+ * same function — if this drifts from xf_input_two_finger_resolve the
+ * regression catches it. */
+static inline int xf_classify_two_finger(double pinchDelta, double panDelta,
+                                         double panDb, double deadbandPx,
+                                         double dominanceRatio)
+{
+	if (pinchDelta >= deadbandPx && pinchDelta > dominanceRatio * panDelta)
+		return 1; /* PINCH */
+	if (panDelta >= panDb)
+		return 2; /* SCROLL */
+	return 0; /* PENDING */
+}
+
+/* ── GAP-04: fractional pinch accumulator ────────────────────────── */
+
+/* Accumulate delta (caller adds delta first), then emit signed wheel
+ * steps from *accum in full-step increments of step.
+ * Returns the signed integer count of wheel steps emitted.
+ * Uses fabs to avoid int truncation of the double accumulator. */
+static inline int xf_pinch_emit_steps(double *accum, double step)
+{
+	int emitted = 0;
+
+	while (fabs(*accum) >= step)
+	{
+		if (*accum > 0)
+		{
+			emitted++;
+			*accum -= step;
+		}
+		else
+		{
+			emitted--;
+			*accum += step;
+		}
+	}
+	return emitted;
+}
+
+/* ── GAP-10: diagnostic lifecycle store ──────────────────────────── */
+
+typedef struct
+{
+	int touchId;
+	int x;
+	int y;
+	int active; /* nonzero if a finger is currently tracked */
+} xfDiagContact;
+
+/* Insert or refresh on duplicate Begin — does NOT increment count. */
+static inline void xf_diag_contact_begin(xfDiagContact *diags, int *count,
+                                         int max, int touchId, int x,
+                                         int y)
+{
+	int i;
+	for (i = 0; i < *count; i++)
+	{
+		if (diags[i].touchId == touchId)
+		{
+			diags[i].x = x;
+			diags[i].y = y;
+			return;
+		}
+	}
+	if (*count >= max)
+		return;
+	diags[*count].touchId = touchId;
+	diags[*count].x = x;
+	diags[*count].y = y;
+	diags[*count].active = 1;
+	(*count)++;
+}
+
+/* Refresh last coordinates for an active diag contact. */
+static inline void xf_diag_contact_update(const xfDiagContact *diags,
+                                          int count, int touchId, int x,
+                                          int y)
+{
+	int i;
+	for (i = 0; i < count; i++)
+	{
+		if (diags[i].touchId == touchId && diags[i].active)
+		{
+			/* Cast away const — struct lifetime is owned by xfContext. */
+			((xfDiagContact *)diags)[i].x = x;
+			((xfDiagContact *)diags)[i].y = y;
+			return;
+		}
+	}
+}
+
+/* Retire a diag contact (compact).  Decrements count. */
+static inline void xf_diag_contact_end(xfDiagContact *diags, int *count,
+                                       int touchId)
+{
+	int i, j;
+	for (i = 0; i < *count; i++)
+	{
+		if (diags[i].touchId == touchId)
+		{
+			for (j = i; j < *count - 1; j++)
+				diags[j] = diags[j + 1];
+			(*count)--;
+			return;
+		}
+	}
+}
+
+/* ── GAP-10: ordered force-cancel emission ───────────────────────── */
+
+typedef enum
+{
+	XF_FC_PHASE_DIAG_CANCEL = 0,
+	XF_FC_PHASE_SUMMARY,
+	XF_FC_PHASE_NATIVE_CANCEL,
+	XF_FC_PHASE_GESTURE_CLEAR
+} xfFcPhase;
+
+typedef void (*xfFcEmitCb)(xfFcPhase phase, int touchId, int x, int y,
+                           int diag_count, int native_count,
+                           int quarantined, void *ctx);
+
+/* Pure ordering helper — owns no xfContext storage.  Snapshots active
+ * diagnostic contacts, emits DIAG_CANCEL at last coords, emits one
+ * SUMMARY with exact counts, emits native cancellations, then emits
+ * GESTURE_CLEAR.  Returns the diagnostic snapshot count.
+ * Called exactly once by xf_touch_cancel_lifecycle (GAP-10). */
+static inline int xf_force_cancel_emit_sequence(
+    const xfDiagContact *diags, int diagCount, int nativeCount,
+    int quarantinedCount, const int *nativeIds, const int *nativeXs,
+    const int *nativeYs, xfFcEmitCb emit, void *ctx)
+{
+	int i;
+	int diagsSnapshot = 0;
+
+	/* Phase 1: DIAG_CANCEL for each active slot at its last coordinates. */
+	for (i = 0; i < diagCount; i++)
+	{
+		if (diags[i].active)
+		{
+			emit(XF_FC_PHASE_DIAG_CANCEL, diags[i].touchId,
+			     diags[i].x, diags[i].y, 0, 0, 0, ctx);
+			diagsSnapshot++;
+		}
+	}
+
+	/* Phase 2: SUMMARY — exact counts. */
+	emit(XF_FC_PHASE_SUMMARY, 0, 0, 0, diagsSnapshot, nativeCount,
+	     quarantinedCount, ctx);
+
+	/* Phase 3: NATIVE_CANCEL — only for synthetic native contacts. */
+	for (i = 0; i < nativeCount; i++)
+		emit(XF_FC_PHASE_NATIVE_CANCEL, nativeIds[i], nativeXs[i],
+		     nativeYs[i], 0, 0, 0, ctx);
+
+	/* Phase 4: GESTURE_CLEAR. */
+	emit(XF_FC_PHASE_GESTURE_CLEAR, 0, 0, 0, 0, 0, 0, ctx);
+
+	return diagsSnapshot;
+}
+
+#endif /* XF_TOUCH_INTERNAL_H */
