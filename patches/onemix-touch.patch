+	CHECK(mouse_events.count == 1, "one wheel event emitted");
+	CHECK(mouse_events.flags[0] == (PTR_FLAGS_WHEEL | 0x78),
+	      "negative vertical delta matches Button4 wheel-up detent");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+static int test_valuator_wheel_horizontal(void)
+{
+	rdpSettings* settings = new_settings();
+	rdpInput input = { 0 };
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	input.context = &xfc.common.context;
+	input.MouseEvent = capture_mouse_event;
+	xfc.common.context.input = &input;
+	mouse_events = (mouse_capture){ 0 };
+
+	unsigned char mask[1] = { 0x04 };
+	double seed[1] = { 0.0 };
+	double values[1] = { 1.0 };
+
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, seed, FALSE);
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, values, FALSE);
+
+	CHECK(mouse_events.count == 1, "one wheel event emitted");
+	CHECK(mouse_events.flags[0] == (PTR_FLAGS_HWHEEL | 0x78),
+	      "positive horizontal delta emits hwheel 0x78 detent");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+static int test_valuator_wheel_axes_0_1_ignored(void)
+{
+	rdpSettings* settings = new_settings();
+	rdpInput input = { 0 };
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	input.context = &xfc.common.context;
+	input.MouseEvent = capture_mouse_event;
+	xfc.common.context.input = &input;
+	mouse_events = (mouse_capture){ 0 };
+
+	/* Only axes 0 and 1 set (x/y motion) — must emit nothing */
+	unsigned char mask[1] = { 0x03 }; /* bits 0 and 1 */
+	double values[2] = { 5.0, 3.0 };
+
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, values, FALSE);
+
+	CHECK(mouse_events.count == 0, "x/y valuators never emit wheel");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+static int test_valuator_wheel_empty_or_null(void)
+{
+	rdpSettings* settings = new_settings();
+	rdpInput input = { 0 };
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	input.context = &xfc.common.context;
+	input.MouseEvent = capture_mouse_event;
+	xfc.common.context.input = &input;
+	mouse_events = (mouse_capture){ 0 };
+
+	/* Empty mask */
+	xf_input_send_wheel_from_valuators(&xfc, NULL, 0, NULL, FALSE);
+	CHECK(mouse_events.count == 0, "NULL mask emits nothing");
+
+	/* Zero mask */
+	unsigned char mask[1] = { 0x00 };
+	double values[1] = { 1.0 };
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, values, FALSE);
+	CHECK(mouse_events.count == 0, "zero mask emits nothing");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+
+static int test_valuator_wheel_vertical_reversal(void)
+{
+	rdpSettings* settings = new_settings();
+	rdpInput input = { 0 };
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	input.context = &xfc.common.context;
+	input.MouseEvent = capture_mouse_event;
+	xfc.common.context.input = &input;
+	mouse_events = (mouse_capture){ 0 };
+
+	unsigned char mask[1] = { 0x08 };
+	double a[1] = { 0.0 };
+	double b[1] = { 15.0 };
+	double c[1] = { 5.0 };
+
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, a, FALSE);
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, b, FALSE);
+	xf_input_send_wheel_from_valuators(&xfc, mask, 1, c, FALSE);
+
+	CHECK(mouse_events.count == 2, "down then up emit two events");
+	CHECK(mouse_events.flags[0] == (PTR_FLAGS_WHEEL | PTR_FLAGS_WHEEL_NEGATIVE | (0x100 - 0x78)),
+	      "increasing vertical last-value is wheel-down");
+	CHECK(mouse_events.flags[1] == (PTR_FLAGS_WHEEL | 0x78),
+	      "decreasing vertical last-value is wheel-up");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+int main(void)
+{
+	CHECK(configure_log_capture(), "configure WLog callback appender");
+	CHECK(test_double_tap_anchor() == 0, "double-tap anchor scenario");
+	CHECK(test_zero_calibration_one_finger_slop() == 0, "zero calibration one-finger scenario");
+	CHECK(test_zero_calibration_two_finger_slop() == 0, "zero calibration two-finger scenario");
+	CHECK(test_zero_calibration_three_finger_slop() == 0, "zero calibration three-finger scenario");
+	CHECK(test_quarantine_recovery() == 0, "quarantine recovery scenario");
+	CHECK(test_diagnostic_lifecycle() == 0, "diagnostic lifecycle scenario");
+	CHECK(test_third_finger_compaction() == 0, "third-finger compaction scenario");
+	CHECK(test_pending_three_finger_lift() == 0, "pending three-finger lift scenario");
+	CHECK(test_valuator_wheel_vertical_positive() == 0, "vertical positive valuator wheel");
+	CHECK(test_valuator_wheel_vertical_negative() == 0, "vertical negative valuator wheel");
+	CHECK(test_valuator_wheel_vertical_reversal() == 0, "vertical valuator reversal after down");
+	CHECK(test_valuator_wheel_horizontal() == 0, "horizontal valuator wheel");
+	CHECK(test_valuator_wheel_axes_0_1_ignored() == 0, "x/y axes ignored for wheel");
+	CHECK(test_valuator_wheel_empty_or_null() == 0, "empty/NULL valuator input ignored");
+	(void)WLog_CloseAppender(WLog_GetRoot());
+	(void)puts("OK");
+	return 0;
+}
