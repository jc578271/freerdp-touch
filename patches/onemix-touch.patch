+/* D-08..D-12: fallback pinch Ctrl+wheel synthesizer (GEST-04).
+ * Called from xf_input_touch_remote when pinchActive is TRUE and a
+ * TouchUpdate arrives for pinchFingerA or pinchFingerB.
+ *
+ * Updates the finger position, computes inter-finger distance, applies
+ * activation deadband, midpoint pointer targeting (D-11), fixed wheel
+ * detents (D-09/10), and reversal hysteresis (D-12). */
+/* Forward declaration for GAP-10 lifecycle owner. */
+/* GAP-10: forward declaration for xf_touch_cancel_lifecycle. */
+static void xf_touch_cancel_lifecycle(xfContext* xfc,
+                                      const int* supplementalIds,
+                                      size_t supplementalCount);
+
+static void xf_input_pinch_update(xfContext* xfc, int touchId, int x, int y)
+{
+	/* Update the position of the finger that reported this event */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else
+		return;
+
+	/* Compute current inter-finger distance */
+	{
+		double dx = (double)(xfc->pinchFingerAx - xfc->pinchFingerBx);
+		double dy = (double)(xfc->pinchFingerAy - xfc->pinchFingerBy);
+		double currentDist = sqrt(dx * dx + dy * dy);
+
+		/* D-11: midpoint pointer targeting — move hidden remote pointer
+		 * to the pinch midpoint before the first wheel tick, so zoom
+		 * centers on the touched content. */
+		if (!xfc->pinchMidpointDone)
+		{
+			int mx = (xfc->pinchFingerAx + xfc->pinchFingerBx) / 2;
+			int my = (xfc->pinchFingerAy + xfc->pinchFingerBy) / 2;
+			freerdp_client_send_button_event(&xfc->common, FALSE,
+			                                 PTR_FLAGS_MOVE, mx, my);
+			xfc->pinchMidpointDone = TRUE;
+		}
+
+		/* D-08: activation deadband — require deliberate movement
+		 * before first detent suppresses accidental micro-movement. */
+		if (!xfc->pinchWheelActive)
+		{
+			double baselineDelta = currentDist - xfc->pinchFirstDist;
+			if (fabs(baselineDelta) <= PINCH_DEADBAND_PX)
+				return;
+			/* Deadband cleared — pinch gesture is now actively zooming */
+			xfc->pinchWheelActive = TRUE;
+		}
+
+		/* D-09, D-10: accumulate distance change, emit fixed wheel
+		 * detents with no speed-based acceleration. */
+		{
+			double delta = currentDist - xfc->pinchLastDist;
+			xfc->pinchAccum += delta;
+
+			/* D-12: reversal hysteresis — when direction sign differs
+			 * from last emitted direction, discard the partial
+			 * accumulator and clear the latched direction so the
+			 * hysteresis fires exactly once (not every tick).  Without
+			 * clearing pinchDir the accumulator is zeroed on every
+			 * reversed-direction tick and can never reach the detent
+			 * threshold, deadlocking direction reversal mid-gesture. */
+			int currentDir = (delta > 0) ? 1 : ((delta < 0) ? -1 : 0);
+			if (currentDir != 0 && xfc->pinchDir != 0 &&
+			    currentDir != xfc->pinchDir)
+			{
+				xfc->pinchAccum = 0.0;
+				xfc->pinchDir = 0;
+			}
+
+			/* Emit full detents via shared fractional helper (GAP-04). */
+			{
+				int steps = xf_pinch_emit_steps(&xfc->pinchAccum,
+				                                (double)PINCH_WHEEL_STEP_PX);
+				while (steps > 0)
+				{
+					/* Fingers apart → zoom in (Ctrl+wheel-up) */
+					freerdp_client_send_wheel_event(&xfc->common,
+					    PTR_FLAGS_WHEEL | 0x78);
+     if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth wheel-up accum=%.3f", (double)xfc->pinchAccum);
+					xfc->pinchDir = 1;
+					steps--;
+				}
+				while (steps < 0)
+				{
+					/* Fingers together → zoom out (Ctrl+wheel-down) */
+					freerdp_client_send_wheel_event(&xfc->common,
+					    PTR_FLAGS_WHEEL | PTR_FLAGS_WHEEL_NEGATIVE |
+					        (0x100 - 0x78));
+     if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth wheel-down accum=%.3f", (double)xfc->pinchAccum);
+					xfc->pinchDir = -1;
+					steps++;
+				}
+			}
+		}
+
+		xfc->pinchLastDist = currentDist;
+	}
+}
+
+/* D-13, D-14: clean up fallback pinch on first-lift or third-finger abort.
+ * Releases Ctrl idempotently and clears all pinch state. */
+static void xf_input_pinch_cleanup(xfContext* xfc, int liftedId)
+{
+	const int remainingId =
+	    (liftedId == xfc->pinchFingerA) ? xfc->pinchFingerB : xfc->pinchFingerA;
+
+	if (xfc->ctrlHeld)
+	{
+		rdpInput* input = xfc->common.context.input;
+		if (input)
+			freerdp_input_send_keyboard_event(input, KBD_FLAGS_RELEASE,
+			                                  RDP_SCANCODE_LCONTROL);
+		xfc->ctrlHeld = FALSE;
+	}
+	xfc->pinchActive = FALSE;
+	xfc->pinchClaimed = FALSE;
+	xfc->pinchWheelActive = FALSE;
+	xfc->pinchAccum = 0.0;
+	xfc->pinchDir = 0;
+	xfc->pinchMidpointDone = FALSE;
+	xfc->pinchFirstDist = 0.0;
+	xfc->pinchLastDist = 0.0;
+	xfc->pinchFingerA = 0;
+	xfc->pinchFingerB = 0;
+
+	/* The remaining physical finger has no native contact in fallback
+	 * mode. Quarantine it until its End so it cannot become a tap. */
+	if (remainingId != 0)
+	{
+		xf_quarantine_update(xfc->quarantinedFingers,
+		                     &xfc->quarantinedCount,
+		                     (int*)&xfc->recoveryGateArmed,
+		                     &remainingId, 1, NULL, 0,
+		                     FREERDP_MAX_TOUCH_CONTACTS);
+	}
+}
+
+/* Resolve two-finger PENDING disambiguation: pinch (distance change) vs
+ * pan (midpoint translation). Called from the top of XI_TouchUpdate while
+ * twoFingerPending is TRUE. Claims the gesture type and produces the
+ * first RDP input event (Ctrl down for pinch, middle-button down for pan). */
+static int xf_input_two_finger_resolve(xfContext* xfc, int touchId, int x, int y)
+{
+	rdpSettings* s = xfc->common.context.settings;
+	UINT32 panDb;
+
+	/* Update the moving finger's stored position. */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else
+		return 0;
+
+	/* Compute current distance and midpoint. */
+	{
+		double dx = (double)(xfc->pinchFingerAx - xfc->pinchFingerBx);
+		double dy = (double)(xfc->pinchFingerAy - xfc->pinchFingerBy);
+		double currentDist = sqrt(dx * dx + dy * dy);
+		int currentMidX = (xfc->pinchFingerAx + xfc->pinchFingerBx) / 2;
+		int currentMidY = (xfc->pinchFingerAy + xfc->pinchFingerBy) / 2;
+		double pinchDelta = fabs(currentDist - xfc->pinchFirstDist);
+		double panDelta = hypot((double)(currentMidX - xfc->twoStartMidX),
+		                        (double)(currentMidY - xfc->twoStartMidY));
+
+		panDb = freerdp_settings_get_uint32(s, FreeRDP_TouchLongPressSlopPx);
+		if (panDb == 0)
+			panDb = 8;
+
+		/* WR-01: shared classifier — production and tests call the same
+		 * xf_classify_two_finger (GAP-02 closure). */
+		{
+			int claim = xf_classify_two_finger(pinchDelta, panDelta,
+			                                  (double)panDb,
+			                                  (double)PINCH_DEADBAND_PX,
+			                                  (double)PINCH_DOMINANCE_RATIO);
+			if (claim == 1) /* PINCH */
+			{
+				xfc->twoFingerPending = FALSE;
+				xfc->pinchActive = TRUE;
+				xfc->pinchLastDist = currentDist;
+				/* Press Ctrl. */
+				{
+					rdpInput* input = xfc->common.context.input;
+					if (input)
+						freerdp_input_send_keyboard_event(input,
+						    KBD_FLAGS_DOWN, RDP_SCANCODE_LCONTROL);
+					xfc->ctrlHeld = TRUE;
+				}
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth ctrl-down");
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state pending->pinch contacts=%d", xfc->active_contacts);
+				WLog_DBG(TAG,
+				    "pinch: claimed d=%.1f A=%d B=%d", pinchDelta,
+				    xfc->pinchFingerA, xfc->pinchFingerB);
+				xf_input_pinch_update(xfc, touchId, x, y);
+				return 0;
+			}
+			if (claim == 2) /* SCROLL */
+			{
+				xfc->twoFingerPending = FALSE;
+				xfc->scrollActive = TRUE;
+				xfc->scrollLastY = currentMidY;
+				xfc->scrollAccum = 0;
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state pending->scroll contacts=%d", xfc->active_contacts);
+				/* Move the hidden remote pointer to the two-finger midpoint
+				 * before the first wheel detent. */
+				freerdp_client_send_button_event(&xfc->common, FALSE,
+				                                 PTR_FLAGS_MOVE, currentMidX,
+				                                 currentMidY);
+				WLog_DBG(TAG,
+				    "pan: claimed two-finger scroll d=%.1f mid=(%d,%d)",
+				    panDelta, currentMidX, currentMidY);
+				return 0;
+			}
+		}
+	return 0;
+	}
+
+}
+
+/* Resolve three-finger PENDING disambiguation.  Called from the top of
+ * XI_TouchUpdate while threeFingerPending is TRUE.  Claims the gesture as a
+ * middle-button pan and produces the first BUTTON3-down event at the
+ * three-finger centroid. */
+static int xf_input_three_finger_resolve(xfContext* xfc, int touchId, int x, int y)
+{
+	rdpSettings* s = xfc->common.context.settings;
+	UINT32 panDb;
+
+	/* Update the moving finger's stored position. */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else if (touchId == xfc->midFingerC)
+	{
+		xfc->midFingerCx = x;
+		xfc->midFingerCy = y;
+	}
+	else
+		return 0;
+
+	/* Compute three-finger centroid and displacement from baseline. */
+	{
+		double midX = (double)(xfc->pinchFingerAx + xfc->pinchFingerBx +
+		                       xfc->midFingerCx) /
+		              3.0;
+		double midY = (double)(xfc->pinchFingerAy + xfc->pinchFingerBy +
+		                       xfc->midFingerCy) /
+		              3.0;
+		double panDelta = hypot(midX - (double)xfc->twoStartMidX,
+		                         midY - (double)xfc->twoStartMidY);
+
+		panDb = freerdp_settings_get_uint32(s, FreeRDP_TouchLongPressSlopPx);
+		if (panDb == 0)
+			panDb = 8;
+
+		if (panDelta >= (double)panDb)
+		{
+			xfc->threeFingerPending = FALSE;
+			xfc->midActive = TRUE;
+			xfc->midLastX = (INT32)midX;
+			xfc->midLastY = (INT32)midY;
+			freerdp_client_send_button_event(&xfc->common, FALSE,
+			                                 PTR_FLAGS_DOWN | PTR_FLAGS_BUTTON3,
+			                                 (INT32)midX, (INT32)midY);
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth mid-down x=%d y=%d", (int)midX, (int)midY);
+			WLog_DBG(TAG,
+			         "pan: claimed three-finger middle-button drag d=%.1f mid=(%d,%d)",
+			         panDelta, (int)midX, (int)midY);
+		}
+	}
+
+	return 0;
+}
+
+/* Fallback mode (TouchPinchWheelFallback=true): client owns the whole physical
+ * gesture from the first TouchBegin. No RDPEI contacts created for normal
+ * gesture fingers. One finger: quick End -> left-click; movement beyond slop
+ * -> mouse drag; deadline -> right-click. Two fingers before completion:
+ * release any held drag, claim local pinch, hold Ctrl, emit fixed wheel detents
+ * from distance change, release Ctrl on first lift, quarantine remaining
+ * physical fingers until lift. Third finger abort: release mouse/Ctrl and
+ * quarantine all participating physical IDs until all lift. */
+static int xf_input_touch_fallback(xfContext* xfc, int evtype, int x, int y, int touchId)
+{
+	/* Pinch/pan/PENDING gate: intercept two-finger gestures for
+	 * Ctrl+wheel synthesis, middle-button pan, or disambiguation.
+	 * No RDPEI forwarding. Third finger aborts. */
+	if (xfc->pinchActive || xfc->midActive || xfc->twoFingerPending ||
+	    xfc->scrollActive || xfc->threeFingerPending)
+	{
+		switch (evtype)
+		{
+			case XI_TouchBegin:
+			{
+				/* Third finger while two-finger gesture is still
+				 * PENDING: upgrade to three-finger pan. */
+				if (xfc->twoFingerPending)
+				{
+					xfc->midFingerC = touchId;
+					xfc->midFingerCx = x;
+					xfc->midFingerCy = y;
+					xfc->twoStartMidX =
+					    (xfc->pinchFingerAx + xfc->pinchFingerBx + x) / 3;
+					xfc->twoStartMidY =
+					    (xfc->pinchFingerAy + xfc->pinchFingerBy + y) / 3;
+					xfc->twoFingerPending = FALSE;
+					xfc->threeFingerPending = TRUE;
+     if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state pending->three-finger contacts=%d", xfc->active_contacts);
+					WLog_DBG(TAG,
+					         "three-finger: pending upgrade C=%d",
+					         touchId);
+					return 0;
+				}
+
+				/* Third (or later) finger aborts. */
+					/* Third (or later) finger aborts (GAP-02, GAP-10). */
+					const int fingerA = xfc->pinchFingerA;
+					const int fingerB = xfc->pinchFingerB;
+					const int savedC = xfc->midFingerC;
+					/* Call lifecycle owner once with supplemental IDs.
+					 * Must NOT call public wrapper, duplicate cancellation,
+					 * or mutate quarantine/gate inline. */
+					{
+						const int supp[4] = { fingerA, fingerB, savedC, touchId };
+						int compact[ARRAYSIZE(supp)];
+						size_t suppCount = 0;
+						for (size_t i = 0; i < ARRAYSIZE(supp); i++)
+						{
+							if (supp[i] != 0)
+								compact[suppCount++] = supp[i];
+						}
+						xf_touch_cancel_lifecycle(xfc, compact, suppCount);
+					}
+    if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state quarantine=%d contacts=%d", xfc->quarantinedCount, xfc->active_contacts);
+					return 0;
+			}
+			case XI_TouchUpdate:
+				/* Route active pinch to wheel synthesis; pan
+				 * and pending are handled in the main switch. */
+				if (xfc->pinchActive)
+				{
+					xf_input_pinch_update(xfc, touchId, x, y);
+					return 0;
+				}
+				break;
+			case XI_TouchEnd:
+				/* Route active pinch cleanup; pan and pending
+				 * end are handled in the main switch. */
+				if (xfc->pinchActive &&
+				    (touchId == xfc->pinchFingerA ||
+				     touchId == xfc->pinchFingerB))
+				{
+					xf_input_pinch_cleanup(xfc, touchId);
+					return 0;
+				}
+				break;
+			default:
+				return 0;
+		}
+	}
+
+	switch (evtype)
+	{
+		case XI_TouchBegin:
+		{
+			/* If a one-finger gesture is in progress, second finger
+			 * enters a disambiguation PENDING state. Pinch vs pan is
+			 * resolved on the first Update based on movement. */
+			if (xfc->lpArmed || xfc->fallbackActive)
+			{
+				const int firstId = xfc->lpFinger;
+				const int firstX = xfc->lpDownX;
+				const int firstY = xfc->lpDownY;
+
+				/* Release any held mouse drag. */
+				if (xfc->fallbackActive)
+				{
+					freerdp_client_send_button_event(&xfc->common, FALSE,
+					    PTR_FLAGS_BUTTON1, firstX, firstY);
+					xfc->fallbackActive = FALSE;
+					xfc->fallbackFinger = 0;
+				}
+				xfc->lpArmed = FALSE;
+				xfc->lpFrozen = FALSE;
+
+				/* Record both fingers; claim pending only. */
+				xfc->pinchFingerA = firstId;
+				xfc->pinchFingerB = touchId;
+				xfc->pinchFingerAx = firstX;
+				xfc->pinchFingerAy = firstY;
+				xfc->pinchFingerBx = x;
+				xfc->pinchFingerBy = y;
+
+				/* Record baseline inter-finger distance and midpoint. */
+				{
+					double dx = (double)(x - firstX);
+					double dy = (double)(y - firstY);
+					xfc->pinchFirstDist = sqrt(dx * dx + dy * dy);
+					xfc->pinchLastDist = xfc->pinchFirstDist;
+				}
+				xfc->twoStartMidX = (firstX + x) / 2;
+				xfc->twoStartMidY = (firstY + y) / 2;
+
+				xfc->twoFingerPending = TRUE;
+				xfc->pinchActive = FALSE;
+				xfc->pinchMidpointDone = FALSE;
+				xfc->pinchWheelActive = FALSE;
+				xfc->pinchAccum = 0.0;
+				xfc->pinchDir = 0;
+
+				WLog_DBG(TAG,
+				    "two-finger: pending A=%d B=%d dist=%.1f mid=(%d,%d)",
+				    firstId, touchId, xfc->pinchFirstDist,
+				    xfc->twoStartMidX, xfc->twoStartMidY);
+				return 0;
+			}
+
+			/* First finger: arm long-press. No RDPEI contact created. */
+			{
+				rdpSettings* settings = xfc->common.context.settings;
+				UINT32 threshold = freerdp_settings_get_uint32(settings,
+				    FreeRDP_TouchLongPressDurationMs);
+				if (threshold == 0)
+					threshold = 600;
+				xfc->lpDownX = x;
+				xfc->lpDownY = y;
+				xfc->lpFinger = touchId;
+				xfc->lpStartTime = GetTickCount64();
+				xfc->lpDeadline = xfc->lpStartTime + threshold;
+				xfc->lpArmed = TRUE;
+				xfc->lpFrozen = FALSE;
+    if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state long-press=arm id=%d x=%d y=%d", touchId, x, y);
+			}
+			return 0;
+		}
+
+		case XI_TouchUpdate:
+			/* Three-finger PENDING: resolve to middle-button pan. */
+			if (xfc->threeFingerPending)
+				return xf_input_three_finger_resolve(xfc, touchId, x, y);
+
+			/* Active two-finger scroll: emit wheel detents. */
+			if (xfc->scrollActive)
+			{
+				if (touchId == xfc->pinchFingerA)
+				{
+					xfc->pinchFingerAx = x;
+					xfc->pinchFingerAy = y;
+				}
+				else if (touchId == xfc->pinchFingerB)
+				{
+					xfc->pinchFingerBx = x;
+					xfc->pinchFingerBy = y;
+				}
+				else
+					return 0;
+
+				int midY = (xfc->pinchFingerAy + xfc->pinchFingerBy) / 2;
+				int deltaY = midY - xfc->scrollLastY;
+				xfc->scrollAccum += deltaY;
+				while (abs(xfc->scrollAccum) >= SCROLL_WHEEL_STEP_PX)
+				{
+					if (xfc->scrollAccum > 0)
+					{
+						freerdp_client_send_wheel_event(
+						    &xfc->common,
+						    PTR_FLAGS_WHEEL | 0x78);
+      if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth scroll-up accum=%d", xfc->scrollAccum);
+						xfc->scrollAccum -= SCROLL_WHEEL_STEP_PX;
+					}
+					else
+					{
+						freerdp_client_send_wheel_event(
+						    &xfc->common,
+						    PTR_FLAGS_WHEEL |
+						        PTR_FLAGS_WHEEL_NEGATIVE |
+						        (0x100 - 0x78));
+      if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth scroll-down accum=%d", xfc->scrollAccum);
+						xfc->scrollAccum += SCROLL_WHEEL_STEP_PX;
+					}
+				}
+				xfc->scrollLastY = midY;
+				return 0;
+			}
+
+			/* Two-finger PENDING: resolve pinch vs pan. */
+			if (xfc->twoFingerPending)
+				return xf_input_two_finger_resolve(xfc, touchId, x, y);
+
+			/* Active middle-button pan: move pointer with centroid. */
+			if (xfc->midActive)
+			{
+				if (touchId == xfc->pinchFingerA)
+				{
+					xfc->pinchFingerAx = x;
+					xfc->pinchFingerAy = y;
+				}
+				else if (touchId == xfc->pinchFingerB)
+				{
+					xfc->pinchFingerBx = x;
+					xfc->pinchFingerBy = y;
+				}
+				else if (touchId == xfc->midFingerC)
+				{
+					xfc->midFingerCx = x;
+					xfc->midFingerCy = y;
+				}
+				else
+					return 0;
+				int midX = (xfc->pinchFingerAx + xfc->pinchFingerBx +
+				            xfc->midFingerCx) /
+				           3;
+				int midY = (xfc->pinchFingerAy + xfc->pinchFingerBy +
+				            xfc->midFingerCy) /
+				           3;
+				freerdp_client_send_button_event(&xfc->common, FALSE,
+				    PTR_FLAGS_MOVE, midX, midY);
+				xfc->midLastX = midX;
+				xfc->midLastY = midY;
+				return 0;
+			}
+
+			/* After a completed long-press, consume all further updates. */
+			if (xfc->lpFrozen && touchId == xfc->lpFinger)
+				return 0;
+
+			if (xfc->lpArmed && touchId == xfc->lpFinger)
+			{
+				rdpSettings* settings = xfc->common.context.settings;
+				UINT32 slop = freerdp_settings_get_uint32(settings,
+				    FreeRDP_TouchLongPressSlopPx);
+				if (slop == 0)
+					slop = 8;
+				double dist = sqrt(pow((double)x - (double)xfc->lpDownX, 2.0) +
+				                   pow((double)y - (double)xfc->lpDownY, 2.0));
+
+				/* Check deadline. */
+				if (GetTickCount64() >= xfc->lpDeadline)
+				{
+					xf_input_fire_long_press(xfc);
+					return 0;
+				}
+
+				/* Sub-slop: ignore (no RDPEI cadence to maintain). */
+				if (dist <= (double)slop)
+					return 0;
+
+				/* Movement claims a deterministic mouse drag. */
+				freerdp_client_send_button_event(&xfc->common, FALSE,
+				    PTR_FLAGS_DOWN | PTR_FLAGS_BUTTON1, xfc->lpDownX, xfc->lpDownY);
+				freerdp_client_send_button_event(&xfc->common, FALSE,
+				    PTR_FLAGS_MOVE, x, y);
+				xfc->lpDownX = x;
+				xfc->lpDownY = y;
+				xfc->fallbackActive = TRUE;
+				xfc->fallbackFinger = touchId;
+				xfc->lpArmed = FALSE;
+    if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state long-press=cancel drag x=%d y=%d", x, y);
+    if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth left-down x=%d y=%d", xfc->lpDownX, xfc->lpDownY);
+				WLog_DBG(TAG, "fallback: touch claimed mouse drag finger=%d", touchId);
+				return 0;
+			}
+
+			/* Active mouse drag: forward motion. */
+			if (xfc->fallbackActive && touchId == xfc->fallbackFinger)
+			{
+				xfc->lpDownX = x;
+				xfc->lpDownY = y;
+				freerdp_client_send_button_event(&xfc->common, FALSE,
+				    PTR_FLAGS_MOVE, x, y);
+			}
+			return 0;
+
+		case XI_TouchEnd:
+			/* Three-finger PENDING lift: clear and quarantine
+			 * the two remaining fingers. */
+			if (xfc->threeFingerPending)
+			{
+				if (touchId == xfc->pinchFingerA ||
+				    touchId == xfc->pinchFingerB ||
+				    touchId == xfc->midFingerC)
+				{
+					int addSet[3];
+					int addCount = 0;
+					if (xfc->pinchFingerA != 0 && xfc->pinchFingerA != touchId)
+						addSet[addCount++] = xfc->pinchFingerA;
+					if (xfc->pinchFingerB != 0 && xfc->pinchFingerB != touchId)
+						addSet[addCount++] = xfc->pinchFingerB;
+					if (xfc->midFingerC != 0 && xfc->midFingerC != touchId)
+						addSet[addCount++] = xfc->midFingerC;
+					xf_quarantine_update(xfc->quarantinedFingers,
+					                     &xfc->quarantinedCount,
+					                     (int*)&xfc->recoveryGateArmed,
+					                     addSet, addCount, NULL, 0,
+					                     FREERDP_MAX_TOUCH_CONTACTS);
+
+					xfc->threeFingerPending = FALSE;
+					xfc->pinchActive = FALSE;
+					xfc->pinchClaimed = FALSE;
+					xfc->pinchFingerA = 0;
+					xfc->pinchFingerB = 0;
+					xfc->pinchFingerAx = 0;
+					xfc->pinchFingerAy = 0;
+					xfc->pinchFingerBx = 0;
