+}
+
+static int test_resolve_speed(void)
+{
+	rdpMonitor monitors[2];
+	RECTANGLE_16 crtcs[2];
+	UINT32 percent = 0;
+	UINT32 sentinel = 0;
+
+	init_above_fixture(monitors, crtcs);
+	unsetenv("FREERDP_EXTERNAL_POINTER_SPEED");
+	percent = 0;
+	CHECK(xf_pointer_resolve_external_speed(monitors, 2, &percent), "absent env derives speed");
+	CHECK(percent == 50, "absent env with 200/100 derives 50");
+
+	(void)setenv("FREERDP_EXTERNAL_POINTER_SPEED", "", 1);
+	percent = 0;
+	CHECK(xf_pointer_resolve_external_speed(monitors, 2, &percent), "empty env derives speed");
+	CHECK(percent == 50, "empty env with 200/100 derives 50");
+
+	(void)setenv("FREERDP_EXTERNAL_POINTER_SPEED", "80", 1);
+	percent = 0;
+	CHECK(xf_pointer_resolve_external_speed(monitors, 2, &percent), "canonical 80 accepted");
+	CHECK(percent == 80, "canonical 80 stored");
+
+	sentinel = 12345;
+	percent = sentinel;
+	(void)setenv("FREERDP_EXTERNAL_POINTER_SPEED", "080", 1);
+	CHECK(!xf_pointer_resolve_external_speed(monitors, 2, &percent), "leading-zero rejected");
+	CHECK(percent == sentinel, "leading-zero leaves out-param");
+
+	percent = sentinel;
+	(void)setenv("FREERDP_EXTERNAL_POINTER_SPEED", "14x", 1);
+	CHECK(!xf_pointer_resolve_external_speed(monitors, 2, &percent), "non-digit rejected");
+	CHECK(percent == sentinel, "non-digit leaves out-param");
+
+	percent = sentinel;
+	(void)setenv("FREERDP_EXTERNAL_POINTER_SPEED", "9", 1);
+	CHECK(!xf_pointer_resolve_external_speed(monitors, 2, &percent), "9 rejected");
+	CHECK(percent == sentinel, "9 leaves out-param");
+
+	percent = sentinel;
+	(void)setenv("FREERDP_EXTERNAL_POINTER_SPEED", "201", 1);
+	CHECK(!xf_pointer_resolve_external_speed(monitors, 2, &percent), "201 rejected");
+	CHECK(percent == sentinel, "201 leaves out-param");
+
+	unsetenv("FREERDP_EXTERNAL_POINTER_SPEED");
+	return 0;
+}
+
+static int test_single_monitor(void)
+{
+	rdpMonitor monitors[1];
+	RECTANGLE_16 crtcs[1];
+	int x = 42;
+	int y = 99;
+	UINT32 percent = 7;
+
+	memset(monitors, 0, sizeof(monitors));
+	memset(crtcs, 0, sizeof(crtcs));
+	monitors[0].is_primary = TRUE;
+	monitors[0].width = 2560;
+	monitors[0].height = 1600;
+	crtcs[0].right = 2559;
+	crtcs[0].bottom = 1599;
+
+	CHECK(!xf_pointer_map_coordinates(&x, &y, monitors, 1, crtcs),
+	      "single monitor leaves global XRender path");
+	CHECK(x == 42 && y == 99, "single monitor does not rewrite coordinates");
+	CHECK(!xf_pointer_resolve_external_speed(monitors, 1, &percent),
+	      "single monitor does not report an accel change");
+	CHECK(percent == 7, "single monitor leaves accel out-param");
+	return 0;
+}
+
+int main(void)
+{
+	CHECK(test_above_fixture() == 0, "above fixture mapping");
+	CHECK(test_shared_edge() == 0, "shared horizontal edge");
+	CHECK(test_scale_accel() == 0, "accel fraction cases");
+	CHECK(test_libinput_accel() == 0, "libinput mapping");
+	CHECK(test_resolve_speed() == 0, "env default/override/reject");
+	CHECK(test_single_monitor() == 0, "single-monitor fallback");
+	(void)puts("OK");
+	return 0;
+}
