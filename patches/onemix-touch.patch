+static void xf_input_OnTimer(void* context, WINPR_ATTR_UNUSED const TimerEventArgs* e)
+{
+	xfContext* xfc = (xfContext*)context;
+	UINT64 now;
+
+	if (!xfc->lpArmed)
+		return;
+
+	now = GetTickCount64();
+	if (now >= xfc->lpDeadline)
+		xf_input_fire_long_press(xfc);
+}
