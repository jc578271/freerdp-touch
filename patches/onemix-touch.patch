Index: src/client/X11/test/TestXfInputDispatcher.c
===================================================================
--- /dev/null
+++ src/client/X11/test/TestXfInputDispatcher.c
@@ -0,0 +1,310 @@
+#include <X11/Xlib.h>
+#include <X11/extensions/XInput2.h>
+
+#include <freerdp/settings.h>
+#include <winpr/wlog.h>
+
+#include <stdio.h>
+#include <string.h>
+
+#include "../xf_input.h"
+#include "../xfreerdp.h"
+
+static char log_capture[16384];
+
+Bool __wrap_XGetEventData(Display* display, XGenericEventCookie* cookie)
+{
+	(void)display;
+	(void)cookie;
+	return True;
+}
+
+void __wrap_XFreeEventData(Display* display, XGenericEventCookie* cookie)
+{
+	(void)display;
+	(void)cookie;
+}
+
+static BOOL capture_message(const wLogMessage* message)
+{
+	size_t used;
+
+	if (!message || !message->TextString || !strstr(message->TextString, "touch-diag:"))
+		return TRUE;
+
+	used = strlen(log_capture);
+	if (used < sizeof(log_capture) - 1)
+		(void)snprintf(log_capture + used, sizeof(log_capture) - used, "%s\n",
+		               message->TextString);
+	return TRUE;
+}
+
+static BOOL ignore_message(const wLogMessage* message)
+{
+	(void)message;
+	return TRUE;
+}
+
+static void clear_log_capture(void)
+{
+	log_capture[0] = '\0';
+}
+
+static int count_substring(const char* haystack, const char* needle)
+{
+	int count = 0;
+	const char* cursor = haystack;
+	size_t length = strlen(needle);
+
+	while ((cursor = strstr(cursor, needle)) != NULL)
+	{
+		count++;
+		cursor += length;
+	}
+	return count;
+}
+
+static int configure_log_capture(void)
+{
+	wLog* root = WLog_GetRoot();
+	wLog* x11 = WLog_Get("com.freerdp.client.x11");
+	wLogAppender* appender = NULL;
+	wLogCallbacks callbacks = { 0 };
+
+	if (!root || !x11)
+		return 0;
+
+	callbacks.data = ignore_message;
+	callbacks.image = ignore_message;
+	callbacks.message = capture_message;
+	callbacks.package = ignore_message;
+
+	if (!WLog_SetLogAppenderType(root, WLOG_APPENDER_CALLBACK))
+		return 0;
+	appender = WLog_GetLogAppender(root);
+	if (!appender || !WLog_ConfigureAppender(appender, "callbacks", &callbacks))
+		return 0;
+	if (!WLog_SetLogLevel(root, WLOG_TRACE) || !WLog_SetLogLevel(x11, WLOG_TRACE))
+		return 0;
+	return WLog_OpenAppender(root) ? 1 : 0;
+}
+
+static rdpSettings* new_settings(void)
+{
+	rdpSettings* settings = freerdp_settings_new(0);
+
+	if (!settings)
+		return NULL;
+	if (!freerdp_settings_set_bool(settings, FreeRDP_TouchPinchWheelFallback, TRUE) ||
+	    !freerdp_settings_set_bool(settings, FreeRDP_MultiTouchInput, FALSE) ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopWidth, 100) ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopHeight, 100))
+	{
+		freerdp_settings_free(settings);
+		return NULL;
+	}
+	return settings;
+}
+
+static void init_context(xfContext* xfc, rdpSettings* settings)
+{
+	memset(xfc, 0, sizeof(*xfc));
+	xfc->common.context.settings = settings;
+	xfc->XInputOpcode = 77;
+	xfc->cursorHidden = TRUE;
+	xfc->remote_app = FALSE;
+	xfc->offset_x = 10;
+	xfc->offset_y = 20;
+	xfc->scaledWidth = 100;
+	xfc->scaledHeight = 100;
+}
+
+static void make_touch_event(XEvent* event, XIDeviceEvent* device, const xfContext* xfc,
+                             int evtype, int touch_id, int x, int y)
+{
+	memset(event, 0, sizeof(*event));
+	memset(device, 0, sizeof(*device));
+
+	event->xcookie.type = GenericEvent;
+	event->xcookie.extension = xfc->XInputOpcode;
+	event->xcookie.evtype = evtype;
+	event->xcookie.data = device;
+
+	device->type = GenericEvent;
+	device->extension = xfc->XInputOpcode;
+	device->evtype = evtype;
+	device->detail = touch_id;
+	device->event_x = x;
+	device->event_y = y;
+}
+
+static int dispatch_touch(xfContext* xfc, int evtype, int touch_id, int x, int y)
+{
+	XEvent event;
+	XIDeviceEvent device;
+
+	make_touch_event(&event, &device, xfc, evtype, touch_id, x, y);
+	return xf_input_handle_event(xfc, &event);
+}
+
+static int has_quarantine(const xfContext* xfc, int touch_id)
+{
+	for (int i = 0; i < xfc->quarantinedCount; i++)
+	{
+		if (xfc->quarantinedFingers[i] == touch_id)
+			return 1;
+	}
+	return 0;
+}
+
+#define CHECK(condition, message) \
+	do \
+	{ \
+		if (!(condition)) \
+		{ \
+			(void)fprintf(stderr, "FAIL: %s\n", message); \
+			return 1; \
+		} \
+	} while (0)
+
+static int test_quarantine_recovery(void)
+{
+	rdpSettings* settings = new_settings();
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 11, 20, 30) == 0, "Begin(A)");
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 12, 40, 50) == 0, "Begin(B)");
+	CHECK(xfc.twoFingerPending, "two-finger pending after Begin(B)");
+
+	xf_touch_force_cancel(&xfc);
+	CHECK(xfc.quarantinedCount == 2 && xfc.recoveryGateArmed, "cancel quarantines A and B");
+	CHECK(has_quarantine(&xfc, 11) && has_quarantine(&xfc, 12), "cancel keeps both old IDs");
+
+	CHECK(dispatch_touch(&xfc, XI_TouchUpdate, 11, 25, 35) == 0, "old Update(A) consumed");
+	CHECK(xfc.quarantinedCount == 2, "old Update(A) preserves quarantine");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 11, 25, 35) == 0, "old End(A) consumed");
+	CHECK(xfc.quarantinedCount == 1 && xfc.recoveryGateArmed && has_quarantine(&xfc, 12),
+	      "partial End(A) keeps B and recovery gate armed");
+
+	xf_touch_force_cancel(&xfc);
+	CHECK(xfc.quarantinedCount == 1 && xfc.recoveryGateArmed && has_quarantine(&xfc, 12),
+	      "repeated cancellation preserves B");
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 12, 40, 50) == 0, "old End(B) consumed");
+	CHECK(xfc.quarantinedCount == 0 && !xfc.recoveryGateArmed, "final old End(B) reopens input");
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 13, 60, 70) == 0, "fresh Begin(C)");
+	CHECK(xfc.lpArmed && xfc.lpFinger == 13, "fresh touch reaches local recognizer");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+static int test_diagnostic_lifecycle(void)
+{
+	rdpSettings* settings = new_settings();
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	xfc.touchDiagEnabled = TRUE;
+	clear_log_capture();
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 31, 20, 30) == 0, "diagnostic Begin(A)");
+	CHECK(dispatch_touch(&xfc, XI_TouchUpdate, 31, 25, 35) == 0, "diagnostic Update(A)");
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 32, 40, 50) == 0, "diagnostic Begin(B)");
+	CHECK(xfc.diagContactCount == 2, "diagnostic store tracks both local contacts");
+
+	xf_touch_force_cancel(&xfc);
+	CHECK(xfc.diagContactCount == 0, "cancellation retires diagnostic contacts");
+	CHECK(strstr(log_capture, "touch-diag: event=cancel id=31 x=15 y=15") != NULL,
+	      "cancel uses adjusted final coordinates for A");
+	CHECK(strstr(log_capture, "touch-diag: event=cancel id=32 x=30 y=30") != NULL,
+	      "cancel uses adjusted final coordinates for B");
+	CHECK(strstr(log_capture, "touch-diag: summary diag_count=2 native_count=0") != NULL,
+	      "summary reports local-only cancellation");
+	CHECK(count_substring(log_capture, "touch-diag: summary") == 1,
+	      "one cancellation summary is emitted");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+static int test_third_finger_compaction(void)
+{
+	rdpSettings* settings = new_settings();
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	xfc.threeFingerPending = TRUE;
+	xfc.pinchFingerA = 41;
+	xfc.pinchFingerB = 42;
+	xfc.midFingerC = 0;
+
+	CHECK(dispatch_touch(&xfc, XI_TouchBegin, 43, 60, 70) == 0, "third-finger abort with sparse supplemental IDs");
+	CHECK(xfc.quarantinedCount == 3 && has_quarantine(&xfc, 41) && has_quarantine(&xfc, 42) &&
+	          has_quarantine(&xfc, 43),
+	      "compacted supplemental IDs retain every nonzero ID");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+static int test_pending_three_finger_lift(void)
+{
+	rdpSettings* settings = new_settings();
+	xfContext xfc;
+
+	CHECK(settings != NULL, "settings allocation");
+	init_context(&xfc, settings);
+	xfc.threeFingerPending = TRUE;
+	xfc.pinchFingerA = 51;
+	xfc.pinchFingerAx = 100;
+	xfc.pinchFingerAy = 110;
+	xfc.pinchFingerB = 52;
+	xfc.pinchFingerBx = 200;
+	xfc.pinchFingerBy = 210;
+	xfc.midFingerC = 53;
+	xfc.midFingerCx = 300;
+	xfc.midFingerCy = 310;
+	xfc.twoStartMidX = 200;
+	xfc.twoStartMidY = 210;
+	xfc.pinchFirstDist = 140.0;
+	xfc.pinchLastDist = 139.0;
+	xfc.pinchAccum = 4.0;
+	xfc.pinchDir = 1;
+	xfc.pinchMidpointDone = TRUE;
+	xfc.pinchWheelActive = TRUE;
+
+	CHECK(dispatch_touch(&xfc, XI_TouchEnd, 51, 100, 110) == 0, "pre-claim three-finger lift");
+	CHECK(xfc.quarantinedCount == 2 && has_quarantine(&xfc, 52) && has_quarantine(&xfc, 53),
+	      "pre-claim lift quarantines both remaining IDs");
+	CHECK(!xfc.threeFingerPending, "pre-claim lift clears pending state");
+	CHECK(xfc.pinchFingerA == 0 && xfc.pinchFingerB == 0 && xfc.midFingerC == 0,
+	      "pre-claim lift clears all three-finger IDs");
+	CHECK(xfc.pinchFingerAx == 0 && xfc.pinchFingerAy == 0 && xfc.pinchFingerBx == 0 &&
+	          xfc.pinchFingerBy == 0 && xfc.midFingerCx == 0 && xfc.midFingerCy == 0,
+	      "pre-claim lift clears all three-finger coordinates");
+	CHECK(xfc.twoStartMidX == 0 && xfc.twoStartMidY == 0 && xfc.pinchFirstDist == 0.0 &&
+	          xfc.pinchLastDist == 0.0 && xfc.pinchAccum == 0.0 && xfc.pinchDir == 0 &&
+	          !xfc.pinchMidpointDone && !xfc.pinchWheelActive,
+	      "pre-claim lift clears midpoint and pinch state");
+
+	freerdp_settings_free(settings);
+	return 0;
+}
+
+int main(void)
+{
+	CHECK(configure_log_capture(), "configure WLog callback appender");
+	CHECK(test_quarantine_recovery() == 0, "quarantine recovery scenario");
+	CHECK(test_diagnostic_lifecycle() == 0, "diagnostic lifecycle scenario");
+	CHECK(test_third_finger_compaction() == 0, "third-finger compaction scenario");
+	CHECK(test_pending_three_finger_lift() == 0, "pending three-finger lift scenario");
+	(void)WLog_CloseAppender(WLog_GetRoot());
+	(void)puts("OK");
+	return 0;
+}
