+	deviceid = xf_pointer_core_device_id(xfc);
+	if (deviceid <= 0)
+		return;
+
+	accel = XInternAtom(xfc->display, "libinput Accel Speed", True);
+	float_atom = XInternAtom(xfc->display, "FLOAT", True);
+	if (accel == None || float_atom == None)
+		return;
+
+	value = (float)speed;
+	XIChangeProperty(xfc->display, deviceid, accel, float_atom, 32, PropModeReplace,
+	                 (unsigned char*)&value, 1);
+}
