+		XChangePointerControl(xfc->display, True, True, xfc->pointerAccelNum, xfc->pointerAccelDen,
+		                      xfc->pointerAccelThreshold);
+		xf_pointer_set_libinput_speed(xfc, 0.0);
+	}
+	else
+	{
+		int num = 0;
+		int den = 0;
+		if (!xf_pointer_scale_accel(xfc->pointerAccelNum, xfc->pointerAccelDen,
+		                            xfc->pointerSpeedPercent, &num, &den))
+			return;
+		XChangePointerControl(xfc->display, True, True, num, den, xfc->pointerAccelThreshold);
+		xf_pointer_set_libinput_speed(xfc, xf_pointer_libinput_accel(xfc->pointerSpeedPercent));
+	}
+
+	xfc->pointerLastCrtc = hit;
+	xfc->pointerAccelHaveLast = TRUE;
+}
