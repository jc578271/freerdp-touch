+	/* Fallback mode owns the gesture — no native RDPEI contact to cancel.
+	 * Release any active mouse drag (defensive: a long-press finger is
+	 * stationary, so fallbackActive should already be false). */
+	if (xfc->fallbackActive)
+	{
+		freerdp_client_send_button_event(&xfc->common, FALSE, PTR_FLAGS_BUTTON1, x, y);
+		xfc->fallbackActive = FALSE;
+		xfc->fallbackFinger = 0;
+	}
+
+	xfc->lpArmed = FALSE;
+	xfc->tapPairValid = FALSE;
+
+	freerdp_client_send_button_event(&xfc->common, FALSE,
+	                                 PTR_FLAGS_DOWN | PTR_FLAGS_BUTTON2, x, y);
+	freerdp_client_send_button_event(&xfc->common, FALSE, PTR_FLAGS_BUTTON2, x, y);
+
+ if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth right-click x=%d y=%d", x, y);
+ if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state long-press=fire x=%d y=%d", x, y); 
+	/* lpFrozen consumes remaining Update/End for this finger. */
+	xfc->lpFrozen = TRUE;
+	xfc->lpFinger = finger;
+	WLog_DBG(TAG, "long_press: sent right-click at x=%d y=%d finger=%d", x, y, finger);
+	return TRUE;
+}
