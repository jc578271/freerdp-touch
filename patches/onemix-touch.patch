+/* Resolve two-finger PENDING disambiguation: pinch (distance change) vs
+ * pan (midpoint translation). Called from the top of XI_TouchUpdate while
+ * twoFingerPending is TRUE. Claims the gesture type and produces the
+ * first RDP input event (Ctrl down for pinch, middle-button down for pan). */
+static int xf_input_two_finger_resolve(xfContext* xfc, int touchId, int x, int y)
+{
+	rdpSettings* s = xfc->common.context.settings;
+	UINT32 panDb;
+
+	/* Update the moving finger's stored position. */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else
+		return 0;
+
+	/* Compute current distance and midpoint. */
+	{
+		double dx = (double)(xfc->pinchFingerAx - xfc->pinchFingerBx);
+		double dy = (double)(xfc->pinchFingerAy - xfc->pinchFingerBy);
+		double currentDist = sqrt(dx * dx + dy * dy);
+		int currentMidX = (xfc->pinchFingerAx + xfc->pinchFingerBx) / 2;
+		int currentMidY = (xfc->pinchFingerAy + xfc->pinchFingerBy) / 2;
+		double pinchDelta = fabs(currentDist - xfc->pinchFirstDist);
+		double panDelta = hypot((double)(currentMidX - xfc->twoStartMidX),
