+static void xf_input_pinch_update(xfContext* xfc, int touchId, int x, int y)
+{
+	/* Update the position of the finger that reported this event */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else
+		return;
+
+	/* Compute current inter-finger distance */
+	{
+		double dx = (double)(xfc->pinchFingerAx - xfc->pinchFingerBx);
+		double dy = (double)(xfc->pinchFingerAy - xfc->pinchFingerBy);
+		double currentDist = sqrt(dx * dx + dy * dy);
+
+		/* D-11: midpoint pointer targeting — move hidden remote pointer
+		 * to the pinch midpoint before the first wheel tick, so zoom
+		 * centers on the touched content. */
+		if (!xfc->pinchMidpointDone)
+		{
+			int mx = (xfc->pinchFingerAx + xfc->pinchFingerBx) / 2;
+			int my = (xfc->pinchFingerAy + xfc->pinchFingerBy) / 2;
+			freerdp_client_send_button_event(&xfc->common, FALSE,
+			                                 PTR_FLAGS_MOVE, mx, my);
+			xfc->pinchMidpointDone = TRUE;
+		}
+
+		/* D-08: activation deadband — require deliberate movement
+		 * before first detent suppresses accidental micro-movement. */
+		if (!xfc->pinchWheelActive)
+		{
+			double baselineDelta = currentDist - xfc->pinchFirstDist;
+			if (fabs(baselineDelta) <= PINCH_DEADBAND_PX)
+				return;
+			/* Deadband cleared — pinch gesture is now actively zooming */
+			xfc->pinchWheelActive = TRUE;
+		}
+
+		/* D-09, D-10: accumulate distance change, emit fixed wheel
+		 * detents with no speed-based acceleration. */
+		{
+			double delta = currentDist - xfc->pinchLastDist;
+			xfc->pinchAccum += delta;
+
+			/* D-12: reversal hysteresis — when direction sign differs
+			 * from last emitted direction, discard the partial
+			 * accumulator and clear the latched direction so the
+			 * hysteresis fires exactly once (not every tick).  Without
+			 * clearing pinchDir the accumulator is zeroed on every
+			 * reversed-direction tick and can never reach the detent
+			 * threshold, deadlocking direction reversal mid-gesture. */
+			int currentDir = (delta > 0) ? 1 : ((delta < 0) ? -1 : 0);
+			if (currentDir != 0 && xfc->pinchDir != 0 &&
+			    currentDir != xfc->pinchDir)
+			{
+				xfc->pinchAccum = 0.0;
+				xfc->pinchDir = 0;
+			}
+
+			/* Emit full detents via shared fractional helper (GAP-04). */
+			{
+				int steps = xf_pinch_emit_steps(&xfc->pinchAccum,
+				                                (double)PINCH_WHEEL_STEP_PX);
+				while (steps > 0)
+				{
+					/* Fingers apart → zoom in (Ctrl+wheel-up) */
+					freerdp_client_send_wheel_event(&xfc->common,
+					    PTR_FLAGS_WHEEL | 0x78);
+     if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth wheel-up accum=%.3f", (double)xfc->pinchAccum);
+					xfc->pinchDir = 1;
+					steps--;
+				}
+				while (steps < 0)
+				{
+					/* Fingers together → zoom out (Ctrl+wheel-down) */
+					freerdp_client_send_wheel_event(&xfc->common,
+					    PTR_FLAGS_WHEEL | PTR_FLAGS_WHEEL_NEGATIVE |
+					        (0x100 - 0x78));
+     if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth wheel-down accum=%.3f", (double)xfc->pinchAccum);
+					xfc->pinchDir = -1;
+					steps++;
+				}
+			}
+		}
+
+		xfc->pinchLastDist = currentDist;
+	}
+}
