+		xf_quarantine_update(xfc->quarantinedFingers,
+		                     &xfc->quarantinedCount,
+		                     (int*)&xfc->recoveryGateArmed,
+		                     addSet, addCount, NULL, 0,
+		                     FREERDP_MAX_TOUCH_CONTACTS);
+	}
