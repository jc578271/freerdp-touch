+ * activation deadband, midpoint pointer targeting (D-11), fixed wheel
+ * detents (D-09/10), and reversal hysteresis (D-12). */
+/* Forward declaration for GAP-10 lifecycle owner. */
+/* GAP-10: forward declaration for xf_touch_cancel_lifecycle. */
+static void xf_touch_cancel_lifecycle(xfContext* xfc,
+                                      const int* supplementalIds,
+                                      size_t supplementalCount);
