+		panDb = freerdp_settings_get_uint32(s, FreeRDP_TouchLongPressSlopPx);
+		if (panDb == 0)
+			panDb = 12;
+
+		/* WR-01: shared classifier — production and tests call the same
+		 * xf_classify_two_finger (GAP-02 closure). */
+		{
+			int claim = xf_classify_two_finger(pinchDelta, panDelta,
+			                                  (double)panDb,
+			                                  (double)PINCH_DEADBAND_PX,
+			                                  (double)PINCH_DOMINANCE_RATIO);
+			if (claim == 1) /* PINCH */
+			{
+				xfc->twoFingerPending = FALSE;
+				xfc->pinchActive = TRUE;
+				xfc->pinchLastDist = currentDist;
+				/* Press Ctrl. */
+				{
+					rdpInput* input = xfc->common.context.input;
+					if (input)
+						freerdp_input_send_keyboard_event(input,
+						    KBD_FLAGS_DOWN, RDP_SCANCODE_LCONTROL);
+					xfc->ctrlHeld = TRUE;
+				}
