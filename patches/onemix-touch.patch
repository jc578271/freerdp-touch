+/* D-08..D-12: fallback pinch Ctrl+wheel synthesizer (GEST-04).
+ * Called from xf_input_touch_remote when pinchActive is TRUE and a
+ * TouchUpdate arrives for pinchFingerA or pinchFingerB.
+ *
+ * Updates the finger position, computes inter-finger distance, applies
+ * activation deadband, midpoint pointer targeting (D-11), fixed wheel
+ * detents (D-09/10), and reversal hysteresis (D-12). */
+static void xf_input_pinch_update(xfContext* xfc, int touchId, int x, int y)
+{
+	/* Update the position of the finger that reported this event */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else
+		return;
+
+	/* Compute current inter-finger distance */
+	{
+		double dx = (double)(xfc->pinchFingerAx - xfc->pinchFingerBx);
+		double dy = (double)(xfc->pinchFingerAy - xfc->pinchFingerBy);
+		double currentDist = sqrt(dx * dx + dy * dy);
+
+		/* D-11: midpoint pointer targeting — move hidden remote pointer
+		 * to the pinch midpoint before the first wheel tick, so zoom
+		 * centers on the touched content. */
+		if (!xfc->pinchMidpointDone)
+		{
+			int mx = (xfc->pinchFingerAx + xfc->pinchFingerBx) / 2;
+			int my = (xfc->pinchFingerAy + xfc->pinchFingerBy) / 2;
+			freerdp_client_send_button_event(&xfc->common, FALSE,
+			                                 PTR_FLAGS_MOVE, mx, my);
+			xfc->pinchMidpointDone = TRUE;
+		}
+
+		/* D-08: activation deadband — require deliberate movement
+		 * before first detent suppresses accidental micro-movement. */
+		if (!xfc->pinchWheelActive)
+		{
+			double baselineDelta = currentDist - xfc->pinchFirstDist;
+			if (fabs(baselineDelta) <= PINCH_DEADBAND_PX)
+				return;
+			/* Deadband cleared — pinch gesture is now actively zooming */
+			xfc->pinchWheelActive = TRUE;
+		}
+
+		/* D-09, D-10: accumulate distance change, emit fixed wheel
+		 * detents with no speed-based acceleration. */
+		{
+			double delta = currentDist - xfc->pinchLastDist;
+			xfc->pinchAccum += (INT32)delta;
+
+			/* D-12: reversal hysteresis — when direction sign differs
+			 * from last emitted direction, discard the partial
+			 * accumulator and clear the latched direction so the
+			 * hysteresis fires exactly once (not every tick).  Without
+			 * clearing pinchDir the accumulator is zeroed on every
+			 * reversed-direction tick and can never reach the detent
+			 * threshold, deadlocking direction reversal mid-gesture. */
+			int currentDir = (delta > 0) ? 1 : ((delta < 0) ? -1 : 0);
+			if (currentDir != 0 && xfc->pinchDir != 0 &&
+			    currentDir != xfc->pinchDir)
+			{
+				xfc->pinchAccum = 0;
+				xfc->pinchDir = 0;
+			}
+
+			/* Emit full detents, keeping sub-step precision in pinchAccum */
+			while (abs(xfc->pinchAccum) >= PINCH_WHEEL_STEP_PX)
+			{
+				if (xfc->pinchAccum > 0)
+				{
+					/* Fingers apart → zoom in (Ctrl+wheel-up) */
+					freerdp_client_send_wheel_event(&xfc->common,
+					    PTR_FLAGS_WHEEL | 0x78);
+     if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth wheel-up accum=%d", xfc->pinchAccum);
+					xfc->pinchDir = 1;
+					xfc->pinchAccum -= PINCH_WHEEL_STEP_PX;
+				}
+				else
+				{
+					/* Fingers together → zoom out (Ctrl+wheel-down) */
+					freerdp_client_send_wheel_event(&xfc->common,
+					    PTR_FLAGS_WHEEL | PTR_FLAGS_WHEEL_NEGATIVE |
+					        (0x100 - 0x78));
+     if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth wheel-down accum=%d", xfc->pinchAccum);
+					xfc->pinchDir = -1;
+					xfc->pinchAccum += PINCH_WHEEL_STEP_PX;
+				}
+			}
+		}
+
+		xfc->pinchLastDist = currentDist;
+	}
+}
+
+/* D-13, D-14: clean up fallback pinch on first-lift or third-finger abort.
+ * Releases Ctrl idempotently and clears all pinch state. */
+static void xf_input_pinch_cleanup(xfContext* xfc, int liftedId)
+{
+	const int remainingId =
+	    (liftedId == xfc->pinchFingerA) ? xfc->pinchFingerB : xfc->pinchFingerA;
+
+	if (xfc->ctrlHeld)
+	{
+		rdpInput* input = xfc->common.context.input;
+		if (input)
+			freerdp_input_send_keyboard_event(input, KBD_FLAGS_RELEASE,
+			                                  RDP_SCANCODE_LCONTROL);
+		xfc->ctrlHeld = FALSE;
+	}
+	xfc->pinchActive = FALSE;
+	xfc->pinchClaimed = FALSE;
+	xfc->pinchWheelActive = FALSE;
+	xfc->pinchAccum = 0;
+	xfc->pinchDir = 0;
+	xfc->pinchMidpointDone = FALSE;
+	xfc->pinchFirstDist = 0.0;
+	xfc->pinchLastDist = 0.0;
+	xfc->pinchFingerA = 0;
+	xfc->pinchFingerB = 0;
+
+	/* The remaining physical finger has no native contact in fallback
+	 * mode. Quarantine it until its End so it cannot become a tap. */
+	if (remainingId != 0)
+	{
+		xfc->quarantinedFingers[0] = remainingId;
+		xfc->quarantinedCount = 1;
+		xfc->recoveryGateArmed = TRUE;
+	}
+}
+
+/* Resolve two-finger PENDING disambiguation: pinch (distance change) vs
+ * pan (midpoint translation). Called from the top of XI_TouchUpdate while
+ * twoFingerPending is TRUE. Claims the gesture type and produces the
+ * first RDP input event (Ctrl down for pinch, middle-button down for pan). */
+static int xf_input_two_finger_resolve(xfContext* xfc, int touchId, int x, int y)
+{
+	rdpSettings* s = xfc->common.context.settings;
+	UINT32 panDb;
+
+	/* Update the moving finger's stored position. */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else
+		return 0;
+
+	/* Compute current distance and midpoint. */
+	{
+		double dx = (double)(xfc->pinchFingerAx - xfc->pinchFingerBx);
+		double dy = (double)(xfc->pinchFingerAy - xfc->pinchFingerBy);
+		double currentDist = sqrt(dx * dx + dy * dy);
+		int currentMidX = (xfc->pinchFingerAx + xfc->pinchFingerBx) / 2;
+		int currentMidY = (xfc->pinchFingerAy + xfc->pinchFingerBy) / 2;
+		double pinchDelta = fabs(currentDist - xfc->pinchFirstDist);
+		double panDelta = hypot((double)(currentMidX - xfc->twoStartMidX),
+		                        (double)(currentMidY - xfc->twoStartMidY));
+
+		panDb = freerdp_settings_get_uint32(s, FreeRDP_TouchLongPressSlopPx);
+		if (panDb == 0)
+			panDb = 8;
+
+		/* Claim PINCH: distance change exceeds deadband AND
+		 * dominates pan by more than PINCH_DOMINANCE_RATIO×.
+		 * A single finger moving alone along the inter-finger axis
+		 * changes distance up to 2x faster than it moves the
+		 * midpoint, so the dominance conjunct lets axial two-finger
+		 * swipes resolve to scroll while pinching with a stationary
+		 * midpoint (panDelta≈0) still claims within the deadband. */
+		if (pinchDelta >= (double)PINCH_DEADBAND_PX &&
+		    pinchDelta > (double)PINCH_DOMINANCE_RATIO * panDelta)
+		{
+			xfc->twoFingerPending = FALSE;
+			xfc->pinchActive = TRUE;
+			xfc->pinchLastDist = currentDist;
+			/* Press Ctrl. */
+			{
+				rdpInput* input = xfc->common.context.input;
+				if (input)
+					freerdp_input_send_keyboard_event(input,
+					    KBD_FLAGS_DOWN, RDP_SCANCODE_LCONTROL);
+				xfc->ctrlHeld = TRUE;
+			}
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth ctrl-down");
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state pending->pinch contacts=%d", xfc->active_contacts);
+			WLog_DBG(TAG,
+			    "pinch: claimed d=%.1f A=%d B=%d", pinchDelta,
+			    xfc->pinchFingerA, xfc->pinchFingerB);
+			xf_input_pinch_update(xfc, touchId, x, y);
+			return 0;
+		}
+
+		/* Claim SCROLL: midpoint displacement exceeds pan deadband. */
+		if (panDelta >= (double)panDb)
+		{
+			xfc->twoFingerPending = FALSE;
+			xfc->scrollActive = TRUE;
+			xfc->scrollLastY = currentMidY;
+			xfc->scrollAccum = 0;
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: state pending->scroll contacts=%d", xfc->active_contacts);
+			/* Move the hidden remote pointer to the two-finger midpoint
+			 * before the first wheel detent. RDP wheel events scroll
+			 * whatever control is under the server-side cursor; without
+			 * this, scrolling targets the stale pointer location (e.g.
+			 * a previously-touched list) instead of the list under the
+			 * fingers. Mirrors the pinch midpoint targeting (D-11). */
+			freerdp_client_send_button_event(&xfc->common, FALSE,
+			                                 PTR_FLAGS_MOVE, currentMidX,
+			                                 currentMidY);
+			WLog_DBG(TAG,
+			    "pan: claimed two-finger scroll d=%.1f mid=(%d,%d)",
+			    panDelta, currentMidX, currentMidY);
+			return 0;
+		}
+	}
+
+	return 0;
+}
+
+/* Resolve three-finger PENDING disambiguation.  Called from the top of
+ * XI_TouchUpdate while threeFingerPending is TRUE.  Claims the gesture as a
+ * middle-button pan and produces the first BUTTON3-down event at the
+ * three-finger centroid. */
+static int xf_input_three_finger_resolve(xfContext* xfc, int touchId, int x, int y)
+{
+	rdpSettings* s = xfc->common.context.settings;
+	UINT32 panDb;
+
+	/* Update the moving finger's stored position. */
+	if (touchId == xfc->pinchFingerA)
+	{
+		xfc->pinchFingerAx = x;
+		xfc->pinchFingerAy = y;
+	}
+	else if (touchId == xfc->pinchFingerB)
+	{
+		xfc->pinchFingerBx = x;
+		xfc->pinchFingerBy = y;
+	}
+	else if (touchId == xfc->midFingerC)
+	{
+		xfc->midFingerCx = x;
+		xfc->midFingerCy = y;
+	}
+	else
+		return 0;
+
+	/* Compute three-finger centroid and displacement from baseline. */
+	{
+		double midX = (double)(xfc->pinchFingerAx + xfc->pinchFingerBx +
+		                       xfc->midFingerCx) /
+		              3.0;
+		double midY = (double)(xfc->pinchFingerAy + xfc->pinchFingerBy +
+		                       xfc->midFingerCy) /
+		              3.0;
+		double panDelta = hypot(midX - (double)xfc->twoStartMidX,
+		                         midY - (double)xfc->twoStartMidY);
+
+		panDb = freerdp_settings_get_uint32(s, FreeRDP_TouchLongPressSlopPx);
+		if (panDb == 0)
+			panDb = 8;
+
+		if (panDelta >= (double)panDb)
+		{
+			xfc->threeFingerPending = FALSE;
+			xfc->midActive = TRUE;
+			xfc->midLastX = (INT32)midX;
+			xfc->midLastY = (INT32)midY;
+			freerdp_client_send_button_event(&xfc->common, FALSE,
+			                                 PTR_FLAGS_DOWN | PTR_FLAGS_BUTTON3,
+			                                 (INT32)midX, (INT32)midY);
+   if (xfc->touchDiagEnabled) WLog_WARN(TAG, "touch-diag: synth mid-down x=%d y=%d", (int)midX, (int)midY);
+			WLog_DBG(TAG,
+			         "pan: claimed three-finger middle-button drag d=%.1f mid=(%d,%d)",
+			         panDelta, (int)midX, (int)midY);
+		}
+	}
+
+	return 0;
+}
+
+/* Fallback mode (TouchPinchWheelFallback=true): client owns the whole physical
+ * gesture from the first TouchBegin. No RDPEI contacts created for normal
+ * gesture fingers. One finger: quick End -> left-click; movement beyond slop
+ * -> mouse drag; deadline -> right-click. Two fingers before completion:
+ * release any held drag, claim local pinch, hold Ctrl, emit fixed wheel detents
+ * from distance change, release Ctrl on first lift, quarantine remaining
+ * physical fingers until lift. Third finger abort: release mouse/Ctrl and
+ * quarantine all participating physical IDs until all lift. */
+static int xf_input_touch_fallback(xfContext* xfc, int evtype, int x, int y, int touchId)
+{
+	/* Pinch/pan/PENDING gate: intercept two-finger gestures for
+	 * Ctrl+wheel synthesis, middle-button pan, or disambiguation.
+	 * No RDPEI forwarding. Third finger aborts. */
+	if (xfc->pinchActive || xfc->midActive || xfc->twoFingerPending ||
+	    xfc->scrollActive || xfc->threeFingerPending)
+	{
+		switch (evtype)
+		{
