+static BOOL xf_pointer_parse_speed(const char* value, UINT32* percent)
+{
+	size_t len = 0;
+	UINT32 parsed = 0;
+
+	if (!value || !percent)
+		return FALSE;
+
+	len = strlen(value);
+	if (len < 2 || len > 3 || value[0] == '0')
+		return FALSE;
+
+	for (size_t i = 0; i < len; i++)
+	{
+		if (value[i] < '0' || value[i] > '9')
+			return FALSE;
+		parsed = parsed * 10 + (UINT32)(value[i] - '0');
+	}
+
+	if (parsed < 10 || parsed > 200)
+		return FALSE;
+
+	*percent = parsed;
+	return TRUE;
+}
+
+static INT64 xf_pointer_i64_abs(INT64 v)
+{
+	return (v < 0) ? -v : v;
+}
+
+static INT64 xf_pointer_gcd(INT64 a, INT64 b)
+{
+	a = xf_pointer_i64_abs(a);
+	b = xf_pointer_i64_abs(b);
+	while (b)
+	{
+		const INT64 t = b;
+		b = a % b;
+		a = t;
+	}
+	return a;
+}
+
+BOOL xf_pointer_map_coordinates(int* x, int* y, const rdpMonitor* monitors, UINT32 nmonitors,
+                                const RECTANGLE_16* crtcs)
+{
+	int px = 0;
+	int py = 0;
+	INT64 bestDist = 0;
+	int bestIndex = -1;
+	int hit = -1;
+
+	if (!x || !y || !monitors || !crtcs || nmonitors < 2)
+		return FALSE;
+
+	px = *x;
+	py = *y;
+
+	for (UINT32 i = 0; i < nmonitors; i++)
+	{
+		const int left = (int)crtcs[i].left;
+		const int top = (int)crtcs[i].top;
+		const int right = (int)crtcs[i].right;
+		const int bottom = (int)crtcs[i].bottom;
+
+		if (px >= left && px <= right && py >= top && py <= bottom)
+		{
+			hit = (int)i;
+			break;
+		}
+
+		{
+			int cx = px;
+			int cy = py;
+			INT64 dx = 0;
+			INT64 dy = 0;
+			INT64 dist = 0;
+
+			if (cx < left)
+				cx = left;
+			else if (cx > right)
+				cx = right;
+			if (cy < top)
+				cy = top;
+			else if (cy > bottom)
+				cy = bottom;
+
+			dx = (INT64)px - cx;
+			dy = (INT64)py - cy;
+			dist = dx * dx + dy * dy;
+			if (bestIndex < 0 || dist < bestDist)
+			{
+				bestDist = dist;
+				bestIndex = (int)i;
+			}
+		}
+	}
+
+	if (hit < 0)
+		hit = bestIndex;
+	if (hit < 0)
+		return FALSE;
+
+	{
+		const RECTANGLE_16* crtc = &crtcs[hit];
+		const rdpMonitor* mon = &monitors[hit];
+		const int crtcW = (int)crtc->right - (int)crtc->left + 1;
+		const int crtcH = (int)crtc->bottom - (int)crtc->top + 1;
+		int lx = px - (int)crtc->left;
+		int ly = py - (int)crtc->top;
+
+		if (lx < 0)
+			lx = 0;
+		if (ly < 0)
+			ly = 0;
+		if (crtcW > 0 && lx >= crtcW)
+			lx = crtcW - 1;
+		if (crtcH > 0 && ly >= crtcH)
+			ly = crtcH - 1;
+
+		if (crtcW > 0 && crtcH > 0 && (crtcW != mon->width || crtcH != mon->height))
+		{
+			lx = (int)(((INT64)lx * mon->width) / crtcW);
+			ly = (int)(((INT64)ly * mon->height) / crtcH);
+			if (mon->width > 0 && lx >= mon->width)
+				lx = mon->width - 1;
+			if (mon->height > 0 && ly >= mon->height)
+				ly = mon->height - 1;
+		}
+
+		*x = mon->x + lx;
+		*y = mon->y + ly;
+	}
+
+	return TRUE;
+}
+
+BOOL xf_pointer_scale_accel(int orig_num, int orig_den, UINT32 percent, int* out_num,
+                            int* out_den)
+{
+	INT64 n = 0;
+	INT64 d = 0;
+	INT64 g = 0;
+
+	if (!out_num || !out_den || orig_num <= 0 || orig_den <= 0 || percent == 0)
+		return FALSE;
+
+	n = (INT64)orig_num * (INT64)percent;
+	d = (INT64)orig_den * 100;
+	g = xf_pointer_gcd(n, d);
+	if (g <= 0)
+		return FALSE;
+	n /= g;
+	d /= g;
+	if (n <= 0 || d <= 0 || n > INT32_MAX || d > INT32_MAX)
+		return FALSE;
+
+	*out_num = (int)n;
+	*out_den = (int)d;
+	return TRUE;
+}
+
+double xf_pointer_libinput_accel(UINT32 percent)
+{
+	double v = ((double)percent - 100.0) / 100.0;
+
+	if (v < -1.0)
+		return -1.0;
+	if (v > 1.0)
+		return 1.0;
+	return v;
+}
+
+BOOL xf_pointer_resolve_external_speed(const rdpMonitor* monitors, UINT32 nmonitors,
+                                       UINT32* percent)
+{
+	const char* value = NULL;
+	UINT32 primary = 0;
+	UINT32 secondary = 0;
+	BOOL havePrimary = FALSE;
+	BOOL haveSecondary = FALSE;
+
+	if (!monitors || !percent || nmonitors < 2)
+		return FALSE;
+
+	value = getenv("FREERDP_EXTERNAL_POINTER_SPEED");
+	if (value && value[0] != '\0')
+		return xf_pointer_parse_speed(value, percent);
+
+	for (UINT32 i = 0; i < nmonitors; i++)
+	{
+		if (monitors[i].is_primary)
+		{
+			primary = monitors[i].attributes.desktopScaleFactor;
+			havePrimary = TRUE;
+		}
+		else if (!haveSecondary)
+		{
+			secondary = monitors[i].attributes.desktopScaleFactor;
+			haveSecondary = TRUE;
+		}
+	}
+
+	if (!havePrimary || !haveSecondary || primary == 0)
+		return FALSE;
+
+	{
+		const UINT32 derived = (100u * secondary) / primary;
+		if (derived < 10 || derived > 200)
+			return FALSE;
+		*percent = derived;
+		return TRUE;
+	}
+}
+
 void xf_event_adjust_coordinates(xfContext* xfc, int* x, int* y)
 {
 	if (!xfc || !xfc->common.context.settings || !y || !x)
@@ -337,12 +555,41 @@ void xf_event_adjust_coordinates(xfConte
